// 6) CLOSED PRESET VALUES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
profileProfit = elpipoProfile == "PROFIT HUNTER"
profileStandard = elpipoProfile == "ELPIPO STANDARD"
profilePrecision = elpipoProfile == "PRECISION MODE"
profileCustom = elpipoProfile == "CUSTOM RESEARCH"
tpSteps = tpStepChoice == "1 Step" ? 1 : tpStepChoice == "2 Steps" ? 2 : 3
slSteps = slStepChoice == "1 Step" ? 1 : slStepChoice == "2 Steps" ? 2 : slStepChoice == "3 Steps" ? 3 : 4
presetBodyMin = profileProfit ? 45.0 : profileStandard ? 52.0 : profilePrecision ? 60.0 : 52.0
presetCloseStrengthMin = profileProfit ? 55.0 : profileStandard ? 65.0 : profilePrecision ? 75.0 : 65.0
presetPredictorEdge = profileProfit ? 5.0 : profileStandard ? 8.0 : profilePrecision ? 12.0 : 8.0
presetComboEdge = profileProfit ? 5.0 : profileStandard ? 8.0 : profilePrecision ? 12.0 : 8.0
presetMaxProgress = profileProfit ? 78.0 : profileStandard ? 68.0 : profilePrecision ? 55.0 : 68.0
presetLateProgress = profileProfit ? 82.0 : profileStandard ? 72.0 : profilePrecision ? 62.0 : 72.0
presetPaidProgress = profileProfit ? 100.0 : profileStandard ? 92.0 : profilePrecision ? 85.0 : 92.0
presetOfficialExpirationBars = profileProfit ? 4 : profileStandard ? 3 : profilePrecision ? 2 : 3
presetStructureLookback = profileProfit ? 4 : profileStandard ? 5 : profilePrecision ? 7 : 5
presetStructureMemory = profileProfit ? 8 : profileStandard ? 6 : profilePrecision ? 4 : 6
presetAcceptanceCloses = profileProfit ? 1 : 2
presetAuthorityMinBrecha = profileProfit ? 58.0 : profileStandard ? 68.0 : profilePrecision ? 78.0 : 68.0
presetAuthorityMinConsensus = profileProfit ? 55.0 : profileStandard ? 65.0 : profilePrecision ? 78.0 : 68.0
presetCategoryQuorumBrecha = profileProfit ? 3 : profileStandard ? 4 : profilePrecision ? 5 : 4
presetCategoryQuorumConsensus = profileProfit ? 0 : profileStandard ? 3 : profilePrecision ? 5 : 4
presetInvalidationCloses = profilePrecision ? 3 : 2
presetEntryToleranceATR = profileProfit ? 0.06 : profileStandard ? 0.04 : profilePrecision ? 0.03 : 0.04
presetReclaimATR = profileProfit ? 0.02 : profileStandard ? 0.03 : profilePrecision ? 0.05 : 0.03
presetStructureBufferATR = profileProfit ? 0.01 : profileStandard ? 0.02 : profilePrecision ? 0.03 : 0.02
presetMinRoomPct = profileProfit ? 20.0 : profileStandard ? 35.0 : profilePrecision ? 45.0 : 35.0
presetADXMin = profileProfit ? 15.0 : profileStandard ? 18.0 : profilePrecision ? 22.0 : 18.0
presetSupertrendFactor = profileProfit ? 2.5 : profileStandard ? 3.0 : profilePrecision ? 3.5 : 3.0
presetSupertrendLength = profileProfit ? 8 : profileStandard ? 10 : profilePrecision ? 14 : 10
presetScoutBodyMin = profileProfit ? 30.0 : profileStandard ? 38.0 : profilePrecision ? 48.0 : 38.0
presetScoutCloseMin = profileProfit ? 48.0 : profileStandard ? 55.0 : profilePrecision ? 65.0 : 55.0
presetScoutMaxProgress = profileProfit ? 88.0 : profileStandard ? 75.0 : profilePrecision ? 62.0 : 75.0
presetScoutExpirationBars = profileProfit ? 6 : profileStandard ? 5 : profilePrecision ? 4 : 5
presetScoutMinRoomPct = profileProfit ? 12.0 : profileStandard ? 22.0 : profilePrecision ? 32.0 : 22.0
consensusRequiredByProfile = profilePrecision or profileCustom

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 7) TYPES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
type ScoutPlan
    int id = 0
    int side = 0
    string state = "NONE"
    float entry = na
    float target = na
    float stop = na
    float step = na
    float gapLow = na
    float gapHigh = na
    int freezeBar = na
    int touchBar = na
    int activeBar = na
    int expiryBar = na
    int freezeTime = na
    int ledgerIndex = -1
    string reason = "—"
    string result = "—"

type TradePlan
    int id = 0
    int scoutId = 0
    int side = 0
    string state = "NONE"
    string source = "—"
    float entry = na
    float target = na
    float stop = na
    float step = na
    int armBar = na
    int touchBar = na
    int activeBar = na
    int expiryBar = na
    int armTime = na
    int ledgerIndex = -1
    float brechaAuthority = na
    float consensusAuthority = na
    string reason = "—"
    string result = "—"

var ScoutPlan scout = ScoutPlan.new()
var TradePlan official = TradePlan.new()
var int nextScoutId = 1
var int nextOfficialId = 1

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 8) COLORS + HELPERS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
cBlack = color.rgb(8,10,15)
cPanel = color.rgb(16,21,34)
cPanel2 = color.rgb(25,33,50)
cPanel3 = color.rgb(38,48,70)
cMuted = color.rgb(103,115,142)
cText = color.white
cSoft = color.rgb(215,220,230)
cBull = color.rgb(0,178,108)
cBullDark = color.rgb(0,102,73)
cBear = color.rgb(220,67,70)
cBearDark = color.rgb(125,43,49)
cWarn = color.rgb(218,162,45)
cYellow = color.rgb(238,194,47)
cBlue = color.rgb(90,155,255)
cTeal = color.rgb(0,145,145)
cScout = color.rgb(176,132,42)
cOfficial = color.rgb(105,176,255)
cActive = color.rgb(35,91,145)
cInvalid = color.rgb(103,61,105)
cIdle = color.rgb(55,65,82)
accumBg = color.new(color.blue,86)
manipBg = color.new(color.orange,84)
distBg = color.new(color.teal,84)
gridIdle = color.new(color.white,64)
centerColor = color.new(color.white,18)
noBg = color.new(color.white,100)

f_pos(string p) => p == "Top Left" ? position.top_left : p == "Top Center" ? position.top_center : p == "Top Right" ? position.top_right : p == "Middle Left" ? position.middle_left : p == "Middle Center" ? position.middle_center : p == "Middle Right" ? position.middle_right : p == "Bottom Left" ? position.bottom_left : p == "Bottom Center" ? position.bottom_center : position.bottom_right
f_size(string s) => s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Large" ? size.large : size.normal
f_small_size(string s) => s == "Large" ? size.normal : s == "Medium" ? size.small : size.tiny
f_big_size(string s) => s == "Large" ? size.huge : s == "Medium" ? size.large : s == "Small" ? size.normal : size.small
f_clamp(float x, float lo, float hi) => math.max(lo,math.min(hi,x))
f_pct(float x) => na(x) ? "—" : str.tostring(x,"#.0") + "%"
f_price(float x) => na(x) ? "—" : str.tostring(x,format.mintick)
f_num(float x) => na(x) ? "—" : str.tostring(x,"#.##")
f_side(int d) => d == 1 ? "BUY" : d == -1 ? "SELL" : "WAIT"
f_side_short(int d) => d == 1 ? "B" : d == -1 ? "S" : "—"
f_month_name(int m) => m == 1 ? "JANUARY" : m == 2 ? "FEBRUARY" : m == 3 ? "MARCH" : m == 4 ? "APRIL" : m == 5 ? "MAY" : m == 6 ? "JUNE" : m == 7 ? "JULY" : m == 8 ? "AUGUST" : m == 9 ? "SEPTEMBER" : m == 10 ? "OCTOBER" : m == 11 ? "NOVEMBER" : "DECEMBER"
f_days_in_month(int y,int m) => m == 2 ? ((y % 400 == 0 or (y % 4 == 0 and y % 100 != 0)) ? 29 : 28) : (m == 4 or m == 6 or m == 9 or m == 11 ? 30 : 31)
f_cell(table t,int c,int r,string txt,color bg,color tc,string sz) => table.cell(t,c,r,txt,bgcolor=bg,text_color=tc,text_size=sz)
f_update_line(line ln,int x1,int x2,float y,color col,int width,string styleName) =>
    if not na(ln)
        line.set_xy1(ln,x1,y)
        line.set_xy2(ln,x2,y)
        line.set_color(ln,col)
        line.set_width(ln,width)
        line.set_style(ln,styleName == "Solid" ? line.style_solid : styleName == "Dashed" ? line.style_dashed : line.style_dotted)
f_update_label(label lb,int x,float y,string txt,color tc) =>
    if not na(lb)
        label.set_x(lb,x)
        label.set_y(lb,y)
        label.set_text(lb,txt)
        label.set_textcolor(lb,tc)
f_scout_pending(string s) => s == "FROZEN"
f_scout_resolved(string s) => s == "WIN" or s == "LOSS" or s == "AMBIGUOUS" or s == "INVALIDATED" or s == "EXPIRED" or s == "NO ENTRY"
f_official_pending(string s) => s == "ARMED" or s == "TOUCHED"
f_official_resolved(string s) => s == "WIN" or s == "LOSS" or s == "AMBIGUOUS" or s == "INVALIDATED" or s == "EXPIRED" or s == "NO ENTRY" or s == "LATE"
f_state_bg(string s) => s == "ACTIVE" ? cActive : s == "ARMED" or s == "FROZEN" ? cScout : s == "TOUCHED" ? cWarn : s == "WIN" ? cBullDark : s == "LOSS" ? cBearDark : s == "AMBIGUOUS" ? color.rgb(165,112,32) : s == "INVALIDATED" ? cInvalid : s == "EXPIRED" or s == "NO ENTRY" or s == "LATE" ? cIdle : cPanel2

masterSize = f_size(masterWindowSizeInput)
masterSmall = f_small_size(masterWindowSizeInput)
masterBig = f_big_size(masterWindowSizeInput)
chartTextSize = f_size(chartTextSizeInput)
calendarTextSize = f_size(calendarSizeInput)
calendarSmall = f_small_size(calendarSizeInput)
calendarBig = f_big_size(calendarSizeInput)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 9) SESSIONS + RAW FEATURES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
inAccum = not na(time(timeframe.period,accumSession,tz))
inManip = not na(time(timeframe.period,manipSession,tz))
inManipSecond = not na(time(timeframe.period,manipSecondHalfSession,tz))
inDist = not na(time(timeframe.period,distSession,tz))
accumStart = inAccum and not (inAccum[1] == true)
manipStart = inManip and not (inManip[1] == true)
distStart = inDist and not (inDist[1] == true)
distEnd = not inDist and inDist[1] == true
atr = ta.atr(14)
body = math.abs(close-open)
rng = high-low
bodyPct = rng > 0 ? body/rng*100.0 : 0.0
upperWickPct = rng > 0 ? (high-math.max(open,close))/rng*100.0 : 0.0
lowerWickPct = rng > 0 ? (math.min(open,close)-low)/rng*100.0 : 0.0
barDir = close > open ? 1 : close < open ? -1 : 0
barCloseTime = int(nz(time_close,time + nz(time-time[1],1)))
entryTolerance = atr*presetEntryToleranceATR
reclaimBuffer = atr*presetReclaimATR
structureBuffer = atr*presetStructureBufferATR
localEMA20 = ta.ema(close,20)
localEMA50 = ta.ema(close,50)
[localDIPlus,localDIMinus,localADX] = ta.dmi(14,14)
[htfClose,htfEMA20,htfEMA50,htfRSI,htfATR,htfHigh20,htfLow20] = request.security(syminfo.tickerid,consensusHTF,[close,ta.ema(close,20),ta.ema(close,50),ta.rsi(close,14),ta.atr(14),ta.highest(high,20),ta.lowest(low,20)])
[supertrendValue,supertrendDirection] = ta.supertrend(presetSupertrendFactor,presetSupertrendLength)
supertrendBull = not useSupertrend or (supertrendDirection < 0 and close > supertrendValue)
supertrendBear = not useSupertrend or (supertrendDirection > 0 and close < supertrendValue)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 10) SESSION + DRAWING STATE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var float accumHigh = na
var float accumLow = na
var float accumBullBody = 0.0
var float accumBearBody = 0.0
var int accumLeftBar = na
var int accumLeftTime = na
var float manipHigh = na
var float manipLow = na
var float manipClose = na
var float manipBullBody = 0.0
var float manipBearBody = 0.0
var int manipLeftBar = na
var int manipLeftTime = na
var bool sweepAccumHigh = false
var bool sweepAccumLow = false
var int centerCrossCount = 0
var float lastManipCenter = na
var float distRangeHigh = na
var float distRangeLow = na
var float distLowest = na
var float distHighest = na
var float distBullBody = 0.0
var float distBearBody = 0.0
var int distLeftBar = na
var int distLeftTime = na
var int distBars = 0
var float accYBody = na
var float accYOpen = na
var float accYClose = na
var float accYHigh = na
var float accYLow = na
var float accYBodyPct = na
var int accYDir = 0
var int accYBar = na
var int accYTime = na
var int accYCloseTime = na
var float manipYBody = na
var float manipYOpen = na
var float manipYClose = na
var float manipYHigh = na
var float manipYLow = na
var float manipYBodyPct = na
var int manipYDir = 0
var int manipYBar = na
var int manipYTime = na
var int manipYCloseTime = na
var int manipYQ = 0
var float largestManipWickPct = na
var int largestManipWickDir = 0
var int largestManipWickQ = 0
var float lockedBullScore = na
var float lockedBearScore = na
var int lockedDirection = 0
var string lockedDirectionSource = "NO CONTEXT"
var bool contextInvalidated = false
var int oppositeInvalidCloseCount = 0
var bool scoutCreatedThisDistribution = false
var bool officialCreatedThisDistribution = false
var bool officialLateRecordedThisDistribution = false
var box accumBox = na
var box manipBox = na
var box distBox = na
var label accumNameLabel = na
var label manipNameLabel = na
var label distNameLabel = na
var line accumCenterH = na
var line accumCenterV = na
var line manipCenterH = na
var line manipCenterV = na
var line distCenterH = na
var line distCenterV = na
var array<label> accumQuadrantLabels = array.new_label(4)
var array<label> manipQuadrantLabels = array.new_label(4)
var box accYBox = na
var line accYWick = na
var box manipYBox = na
var line manipYWick = na
var array<line> ladderLines = array.new_line(7)
var array<label> ladderLabels = array.new_label(7)
var line planEntryLine = na
var line planTargetLine = na
var line planStopLine = na
var label planEntryLabel = na
var label planTargetLabel = na
var label planStopLabel = na
var array<line> dimensionLines = array.new_line(18)
var array<label> dimensionLabels = array.new_label(6)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 11) RESET + SESSION BUILD
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if accumStart
    accumHigh := high
    accumLow := low
    accumBullBody := 0.0
    accumBearBody := 0.0
    accumLeftBar := bar_index
    accumLeftTime := time
    manipHigh := na
    manipLow := na
    manipClose := na
    manipBullBody := 0.0
    manipBearBody := 0.0
    manipLeftBar := na
    manipLeftTime := na
    sweepAccumHigh := false
    sweepAccumLow := false
    centerCrossCount := 0
    lastManipCenter := na
    distRangeHigh := na
    distRangeLow := na
    distLowest := na
    distHighest := na
    distBullBody := 0.0
    distBearBody := 0.0
    distLeftBar := na
    distLeftTime := na
    distBars := 0
    accYBody := na
    accYOpen := na
    accYClose := na
    accYHigh := na
    accYLow := na
    accYBodyPct := na
    accYDir := 0
    accYBar := na
    accYTime := na
    accYCloseTime := na
    manipYBody := na
    manipYOpen := na
    manipYClose := na
    manipYHigh := na
    manipYLow := na
    manipYBodyPct := na
    manipYDir := 0
    manipYBar := na
    manipYTime := na
    manipYCloseTime := na
    manipYQ := 0
    largestManipWickPct := na
    largestManipWickDir := 0
    largestManipWickQ := 0
    lockedBullScore := na
    lockedBearScore := na
    lockedDirection := 0
    lockedDirectionSource := "NO CONTEXT"
    contextInvalidated := false
    oppositeInvalidCloseCount := 0
    scoutCreatedThisDistribution := false
    officialCreatedThisDistribution := false
    officialLateRecordedThisDistribution := false
    scout := ScoutPlan.new()
    official := TradePlan.new()
    accumCenterH := na
    accumCenterV := na
    accYBox := na
    accYWick := na
    for resetQuadrant = 0 to 3
        array.set(accumQuadrantLabels,resetQuadrant,na)
    if showSessionBoxes
        accumBox := box.new(accumLeftTime,high,barCloseTime,low,xloc=xloc.bar_time,bgcolor=accumBg,border_color=color.white,border_width=1)
    if showSessionNames
        accumNameLabel := label.new(bar_index,high,"ACCUMULATION\n19:00 – 01:00",style=label.style_none,textcolor=cText,color=noBg,size=size.small)

if inAccum
    accumHigh := math.max(nz(accumHigh,high),high)
    accumLow := math.min(nz(accumLow,low),low)
    if barstate.isconfirmed
        accumBullBody += close > open ? body : 0.0
        accumBearBody += close < open ? body : 0.0
        bool accCandidate = na(accYBody) or body > accYBody or body >= nz(accYBody,body)*0.88
        if accCandidate
            accYBody := body
            accYOpen := open
            accYClose := close
            accYHigh := high
            accYLow := low
            accYBodyPct := bodyPct
            accYDir := barDir
            accYBar := bar_index
            accYTime := time
            accYCloseTime := barCloseTime
    float accumMid = (accumHigh+accumLow)/2.0
    int accumCenterBar = int(math.round((accumLeftBar+bar_index)/2.0))
    if showSessionBoxes and not na(accumBox)
        box.set_right(accumBox,barCloseTime)
        box.set_top(accumBox,accumHigh)
        box.set_bottom(accumBox,accumLow)
    if showSessionNames and not na(accumNameLabel)
        label.set_x(accumNameLabel,accumCenterBar)
        label.set_y(accumNameLabel,accumHigh)
    if showCenterLines
        if na(accumCenterH)
            accumCenterH := line.new(accumLeftBar,accumMid,bar_index,accumMid,xloc=xloc.bar_index,color=centerColor,style=line.style_dotted)
            accumCenterV := line.new(accumCenterBar,accumHigh,accumCenterBar,accumLow,xloc=xloc.bar_index,color=centerColor,style=line.style_dotted)
        else
            line.set_xy1(accumCenterH,accumLeftBar,accumMid)
            line.set_xy2(accumCenterH,bar_index,accumMid)
            line.set_xy1(accumCenterV,accumCenterBar,accumHigh)
            line.set_xy2(accumCenterV,accumCenterBar,accumLow)
    if showQuadrants
        int aqx1 = int(math.round((accumLeftBar+accumCenterBar)/2.0))
        int aqx2 = int(math.round((accumCenterBar+bar_index)/2.0))
        float aqy1 = (accumHigh+accumMid)/2.0
        float aqy2 = (accumLow+accumMid)/2.0
        array<int> aqxs = array.from(aqx1,aqx2,aqx1,aqx2)
        array<float> aqys = array.from(aqy1,aqy1,aqy2,aqy2)
        for qi = 0 to 3
            label qlb = array.get(accumQuadrantLabels,qi)
            if na(qlb)
                qlb := label.new(array.get(aqxs,qi),array.get(aqys,qi),"Q"+str.tostring(qi+1),style=label.style_none,textcolor=color.new(color.white,35),color=noBg,size=size.small)
                array.set(accumQuadrantLabels,qi,qlb)
            else
                label.set_x(qlb,array.get(aqxs,qi))
                label.set_y(qlb,array.get(aqys,qi))
    if showYellowCandles and not na(accYBar)
        if na(accYBox)
            accYBox := box.new(accYTime,math.max(accYOpen,accYClose),accYCloseTime,math.min(accYOpen,accYClose),xloc=xloc.bar_time,bgcolor=cYellow,border_color=cYellow,border_width=2)
            int accWickMid = int(math.round((accYTime+accYCloseTime)/2.0))
            accYWick := line.new(accWickMid,accYHigh,accWickMid,accYLow,xloc=xloc.bar_time,color=cYellow,width=2)
        else
            box.set_left(accYBox,accYTime)
            box.set_right(accYBox,accYCloseTime)
            box.set_top(accYBox,math.max(accYOpen,accYClose))
            box.set_bottom(accYBox,math.min(accYOpen,accYClose))
            int accWickMid = int(math.round((accYTime+accYCloseTime)/2.0))
            line.set_xy1(accYWick,accWickMid,accYHigh)
            line.set_xy2(accYWick,accWickMid,accYLow)

if manipStart
    manipHigh := high
    manipLow := low
    manipClose := close
    manipBullBody := 0.0
    manipBearBody := 0.0
    manipLeftBar := bar_index
    manipLeftTime := time
    sweepAccumHigh := false
    sweepAccumLow := false
    centerCrossCount := 0
    lastManipCenter := (high+low)/2.0
    manipCenterH := na
    manipCenterV := na
    manipYBox := na
    manipYWick := na
    for resetQuadrant = 0 to 3
        array.set(manipQuadrantLabels,resetQuadrant,na)
    if showSessionBoxes
        manipBox := box.new(manipLeftTime,high,barCloseTime,low,xloc=xloc.bar_time,bgcolor=manipBg,border_color=color.white,border_width=1)
    if showSessionNames
        manipNameLabel := label.new(bar_index,high,"MANIPULATION\n01:00 – 07:00",style=label.style_none,textcolor=cText,color=noBg,size=size.small)

if inManip
    float previousCenter = lastManipCenter
    manipHigh := math.max(nz(manipHigh,high),high)
    manipLow := math.min(nz(manipLow,low),low)
    manipClose := close
    float manipCenter = (manipHigh+manipLow)/2.0
    lastManipCenter := manipCenter
    sweepAccumHigh := not na(accumHigh) and manipHigh > accumHigh
    sweepAccumLow := not na(accumLow) and manipLow < accumLow
    float manipPosition = manipHigh > manipLow ? (close-manipLow)/(manipHigh-manipLow) : 0.5
    int liveManipQ = manipPosition >= 0.5 ? (inManipSecond ? 2 : 1) : (inManipSecond ? 4 : 3)
    if barstate.isconfirmed
        manipBullBody += close > open ? body : 0.0
        manipBearBody += close < open ? body : 0.0
        if not na(previousCenter) and ((close > manipCenter and close[1] <= previousCenter) or (close < manipCenter and close[1] >= previousCenter))
            centerCrossCount += 1
        if na(manipYBody) or body > manipYBody
            manipYBody := body
            manipYOpen := open
            manipYClose := close
            manipYHigh := high
            manipYLow := low
            manipYBodyPct := bodyPct
            manipYDir := barDir
            manipYBar := bar_index
            manipYTime := time
            manipYCloseTime := barCloseTime
            manipYQ := liveManipQ
        float dominantWick = math.max(upperWickPct,lowerWickPct)
        if na(largestManipWickPct) or dominantWick > largestManipWickPct
            largestManipWickPct := dominantWick
            largestManipWickDir := lowerWickPct >= upperWickPct ? 1 : -1
            largestManipWickQ := liveManipQ
    int manipCenterBar = int(math.round((manipLeftBar+bar_index)/2.0))
    if showSessionBoxes and not na(manipBox)
        box.set_right(manipBox,barCloseTime)
        box.set_top(manipBox,manipHigh)
        box.set_bottom(manipBox,manipLow)
    if showSessionNames and not na(manipNameLabel)
        label.set_x(manipNameLabel,manipCenterBar)
        label.set_y(manipNameLabel,manipHigh)
    if showCenterLines
        if na(manipCenterH)
            manipCenterH := line.new(manipLeftBar,manipCenter,bar_index,manipCenter,xloc=xloc.bar_index,color=centerColor,style=line.style_dotted)
            manipCenterV := line.new(manipCenterBar,manipHigh,manipCenterBar,manipLow,xloc=xloc.bar_index,color=centerColor,style=line.style_dotted)
        else
            line.set_xy1(manipCenterH,manipLeftBar,manipCenter)
            line.set_xy2(manipCenterH,bar_index,manipCenter)
            line.set_xy1(manipCenterV,manipCenterBar,manipHigh)
            line.set_xy2(manipCenterV,manipCenterBar,manipLow)
    if showQuadrants
        int mqx1 = int(math.round((manipLeftBar+manipCenterBar)/2.0))
        int mqx2 = int(math.round((manipCenterBar+bar_index)/2.0))
        float mqy1 = (manipHigh+manipCenter)/2.0
        float mqy2 = (manipLow+manipCenter)/2.0
        array<int> mqxs = array.from(mqx1,mqx2,mqx1,mqx2)
        array<float> mqys = array.from(mqy1,mqy1,mqy2,mqy2)
        for qi = 0 to 3
            label qlb = array.get(manipQuadrantLabels,qi)
            if na(qlb)
                qlb := label.new(array.get(mqxs,qi),array.get(mqys,qi),"Q"+str.tostring(qi+1),style=label.style_none,textcolor=color.new(color.white,35),color=noBg,size=size.small)
                array.set(manipQuadrantLabels,qi,qlb)
            else
                label.set_x(qlb,array.get(mqxs,qi))
                label.set_y(qlb,array.get(mqys,qi))
    if showYellowCandles and not na(manipYBar)
        if na(manipYBox)
            manipYBox := box.new(manipYTime,math.max(manipYOpen,manipYClose),manipYCloseTime,math.min(manipYOpen,manipYClose),xloc=xloc.bar_time,bgcolor=cYellow,border_color=cYellow,border_width=2)
            int manipWickMid = int(math.round((manipYTime+manipYCloseTime)/2.0))
            manipYWick := line.new(manipWickMid,manipYHigh,manipWickMid,manipYLow,xloc=xloc.bar_time,color=cYellow,width=2)
        else
            box.set_left(manipYBox,manipYTime)
            box.set_right(manipYBox,manipYCloseTime)
            box.set_top(manipYBox,math.max(manipYOpen,manipYClose))
            box.set_bottom(manipYBox,math.min(manipYOpen,manipYClose))
            int manipWickMid = int(math.round((manipYTime+manipYCloseTime)/2.0))
            line.set_xy1(manipYWick,manipWickMid,manipYHigh)
            line.set_xy2(manipYWick,manipWickMid,manipYLow)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 12) AMD CONTEXT — ACCUMULATION + MANIPULATION ONLY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
accumTotal = accumBullBody+accumBearBody
accumGreenPct = accumTotal > 0 ? accumBullBody/accumTotal*100.0 : na
accumRedPct = accumTotal > 0 ? accumBearBody/accumTotal*100.0 : na
accumOverall = accumTotal > 0 ? math.abs(accumBullBody-accumBearBody)/accumTotal*100.0 : na
accumDirection = accumBullBody > accumBearBody ? 1 : accumBearBody > accumBullBody ? -1 : 0
accumSigned = accumDirection*nz(accumOverall,0.0)
manipTotal = manipBullBody+manipBearBody
manipGreenPct = manipTotal > 0 ? manipBullBody/manipTotal*100.0 : na
manipRedPct = manipTotal > 0 ? manipBearBody/manipTotal*100.0 : na
manipOverall = manipTotal > 0 ? math.abs(manipBullBody-manipBearBody)/manipTotal*100.0 : na
manipDirection = manipBullBody > manipBearBody ? 1 : manipBearBody > manipBullBody ? -1 : 0
manipSigned = manipDirection*nz(manipOverall,0.0)
signedCombo = accumSigned+manipSigned
comboAbs = math.abs(signedCombo)
accYShare = accumTotal > 0 and not na(accYBody) ? accYBody/accumTotal*100.0 : na
manipYShare = manipTotal > 0 and not na(manipYBody) ? manipYBody/manipTotal*100.0 : na
accYScore = not na(accYBodyPct) and not na(accYShare) ? f_clamp(accYBodyPct*0.65+accYShare*0.35,0.0,100.0) : na
manipYScore = not na(manipYBodyPct) and not na(manipYShare) ? f_clamp(manipYBodyPct*0.65+manipYShare*0.35,0.0,100.0) : na
accYQualified = not na(accYBodyPct) and accYBodyPct >= presetBodyMin
manipYQualified = not na(manipYBodyPct) and manipYBodyPct >= presetBodyMin
dualYellowAgree = accYQualified and manipYQualified and accYDir != 0 and accYDir == manipYDir
dualYellowConflict = accYQualified and manipYQualified and accYDir != 0 and manipYDir != 0 and accYDir != manipYDir
silentAccum = nz(accumOverall,100.0) <= 5.0
silentManip = nz(manipOverall,100.0) <= 5.0
balanceContext = nz(accumOverall,100.0) <= 8.0 and nz(manipOverall,100.0) <= 8.0
bothAccumSweeps = sweepAccumHigh and sweepAccumLow
float contextBullScore = useComboAuthority ? f_clamp(50.0+signedCombo*0.55,0.0,100.0) : 50.0
float contextBearScore = useComboAuthority ? f_clamp(50.0-signedCombo*0.55,0.0,100.0) : 50.0
string liveContextRead = useComboAuthority ? "PERCENT PRESSURE" : "COMBO OFF"
if useDualYellow
    if dualYellowAgree
        if accYDir == 1
            contextBullScore += 24.0
            contextBearScore -= 8.0
            liveContextRead := "DUAL YELLOW BULL"
        else
            contextBearScore += 24.0
            contextBullScore -= 8.0
            liveContextRead := "DUAL YELLOW BEAR"
    else if dualYellowConflict
        bool accumulationWinsYellow = nz(accYScore,0.0) >= nz(manipYScore,0.0)
        int yellowWinnerDirection = accumulationWinsYellow ? accYDir : manipYDir
        if yellowWinnerDirection == 1
            contextBullScore += 12.0
            contextBearScore -= 5.0
        else if yellowWinnerDirection == -1
            contextBearScore += 12.0
            contextBullScore -= 5.0
        liveContextRead := accumulationWinsYellow ? "ACC YELLOW LEADS" : "MANIP YELLOW OVERRIDE"
if usePsychology
    if bothAccumSweeps
        contextBullScore -= 8.0
        contextBearScore -= 8.0
        liveContextRead := "BOTH-SIDE SWEEP · DIRTY"
    if (silentAccum and silentManip) or balanceContext
        if manipYQualified and manipYDir == 1
            contextBullScore += 18.0
            contextBearScore -= 7.0
            liveContextRead := "SILENT BULL POWER"
        else if manipYQualified and manipYDir == -1
            contextBearScore += 18.0
            contextBullScore -= 7.0
            liveContextRead := "SILENT BEAR POWER"
    if largestManipWickDir == 1 and (largestManipWickQ == 3 or largestManipWickQ == 4)
        contextBullScore += 8.0
    if largestManipWickDir == -1 and (largestManipWickQ == 1 or largestManipWickQ == 2)
        contextBearScore += 8.0
contextBullScore := f_clamp(contextBullScore,0.0,100.0)
contextBearScore := f_clamp(contextBearScore,0.0,100.0)
livePredictorEdge = math.abs(contextBullScore-contextBearScore)
livePredictorDirection = contextBullScore > contextBearScore+presetPredictorEdge ? 1 : contextBearScore > contextBullScore+presetPredictorEdge ? -1 : 0
liveDirectionSource = dualYellowAgree and useDualYellow ? "DUAL YELLOW " + f_side(accYDir) : livePredictorDirection != 0 ? "AMD PREDICTOR " + f_side(livePredictorDirection) : "NO CLEAR AMD EDGE"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 13) DISTRIBUTION — LOCK CONTEXT, NEVER AUTO-REVERSE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if distStart
    distRangeHigh := manipHigh
    distRangeLow := manipLow
    distLowest := low
    distHighest := high
    distBullBody := 0.0
    distBearBody := 0.0
    distLeftBar := bar_index
    distLeftTime := time
    distBars := 1
    lockedBullScore := contextBullScore
    lockedBearScore := contextBearScore
    lockedDirection := lockDirectionAtDistribution ? livePredictorDirection : livePredictorDirection
    lockedDirectionSource := liveDirectionSource
    contextInvalidated := false
    oppositeInvalidCloseCount := 0
    scoutCreatedThisDistribution := false
    officialCreatedThisDistribution := false
    officialLateRecordedThisDistribution := false
    distCenterH := na
    distCenterV := na
    scout := ScoutPlan.new()
    official := TradePlan.new()
    if showSessionBoxes and not na(distRangeHigh) and not na(distRangeLow)
        distBox := box.new(distLeftTime,distRangeHigh,barCloseTime,distRangeLow,xloc=xloc.bar_time,bgcolor=distBg,border_color=color.white,border_width=1)
    if showSessionNames and not na(distRangeHigh)
        distNameLabel := label.new(bar_index,distRangeHigh,"DISTRIBUTION\n07:00 – 13:00",style=label.style_none,textcolor=cText,color=noBg,size=size.small)

if inDist
    distLowest := math.min(nz(distLowest,low),low)
    distHighest := math.max(nz(distHighest,high),high)
    distBars := distStart ? 1 : distBars+1
    if barstate.isconfirmed
        distBullBody += close > open ? body : 0.0
        distBearBody += close < open ? body : 0.0
    if showSessionBoxes and not na(distBox)
        box.set_right(distBox,barCloseTime)
        box.set_top(distBox,distRangeHigh)
        box.set_bottom(distBox,distRangeLow)
    if showSessionNames and not na(distNameLabel)
        int distCenterBar = int(math.round((distLeftBar+bar_index)/2.0))
        label.set_x(distNameLabel,distCenterBar)
        label.set_y(distNameLabel,distRangeHigh)
    if showCenterLines and not na(distRangeHigh) and not na(distRangeLow)
        float visualDistCenter = (distRangeHigh+distRangeLow)/2.0
        int distCenterBar = int(math.round((distLeftBar+bar_index)/2.0))
        if na(distCenterH)
            distCenterH := line.new(distLeftBar,visualDistCenter,bar_index,visualDistCenter,xloc=xloc.bar_index,color=centerColor,style=line.style_dotted)
            distCenterV := line.new(distCenterBar,distRangeHigh,distCenterBar,distRangeLow,xloc=xloc.bar_index,color=centerColor,style=line.style_dotted)
        else
            line.set_xy1(distCenterH,distLeftBar,visualDistCenter)
            line.set_xy2(distCenterH,bar_index,visualDistCenter)
            line.set_xy1(distCenterV,distCenterBar,distRangeHigh)
            line.set_xy2(distCenterV,distCenterBar,distRangeLow)

distTotal = distBullBody+distBearBody
distBullPct = distTotal > 0 ? distBullBody/distTotal*100.0 : 50.0
distBearPct = distTotal > 0 ? distBearBody/distTotal*100.0 : 50.0
hasManipRange = not na(manipHigh) and not na(manipLow) and manipHigh > manipLow
ladderRange = hasManipRange ? manipHigh-manipLow : na
ladderStep = hasManipRange ? ladderRange*0.25 : na
levelP3 = hasManipRange ? manipHigh+ladderStep : na
levelP2 = hasManipRange ? manipHigh : na
levelP1 = hasManipRange ? manipLow+ladderRange*0.75 : na
levelZ = hasManipRange ? manipLow+ladderRange*0.50 : na
levelM1 = hasManipRange ? manipLow+ladderRange*0.25 : na
levelM2 = hasManipRange ? manipLow : na
levelM3 = hasManipRange ? manipLow-ladderStep : na
distCenter = hasManipRange ? levelZ : na
if inDist and barstate.isconfirmed and lockedDirection != 0 and not na(distCenter)
    bool oppositeClose = lockedDirection == 1 ? close < distCenter-structureBuffer : close > distCenter+structureBuffer
    oppositeInvalidCloseCount := oppositeClose ? oppositeInvalidCloseCount+1 : 0
    bool oppositePressure = lockedDirection == 1 ? distBearPct >= 60.0 : distBullPct >= 60.0
    if oppositeInvalidCloseCount >= presetInvalidationCloses and oppositePressure
        contextInvalidated := true
officialContextSide = contextInvalidated ? 0 : lockedDirection
officialBullScore = lockDirectionAtDistribution and not na(lockedBullScore) ? lockedBullScore : contextBullScore
officialBearScore = lockDirectionAtDistribution and not na(lockedBearScore) ? lockedBearScore : contextBearScore
officialPredictorEdge = math.abs(officialBullScore-officialBearScore)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 14) PATTERNS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
prevBull = close[1] > open[1]
prevBear = close[1] < open[1]
prevBody = math.abs(close[1]-open[1])
prevMidBody = (open[1]+close[1])/2.0
isDoji = bodyPct <= 10.0
isHammer = lowerWickPct >= bodyPct*2.2 and upperWickPct <= math.max(bodyPct*0.75,8.0) and bodyPct > 10.0
isShootingStar = upperWickPct >= bodyPct*2.2 and lowerWickPct <= math.max(bodyPct*0.75,8.0) and bodyPct > 10.0
isBullEngulf = prevBear and close > open and open <= close[1] and close >= open[1] and bodyPct >= 55.0
isBearEngulf = prevBull and close < open and open >= close[1] and close <= open[1] and bodyPct >= 55.0
isPiercing = prevBear and close > open and open < close[1] and close > prevMidBody and close < open[1] and bodyPct >= 35.0
isDarkCloud = prevBull and close < open and open > close[1] and close < prevMidBody and close > open[1] and bodyPct >= 35.0
isBullHarami = prevBear and close > open and open > close[1] and close < open[1] and body < prevBody and bodyPct <= 45.0
isBearHarami = prevBull and close < open and open < close[1] and close > open[1] and body < prevBody and bodyPct <= 45.0
currentBullPattern = usePatternEngine and (isBullEngulf or isPiercing or isHammer or isBullHarami)
currentBearPattern = usePatternEngine and (isBearEngulf or isDarkCloud or isShootingStar or isBearHarami)
currentDojiPattern = usePatternEngine and isDoji and not currentBullPattern and not currentBearPattern
bullPatternBars = ta.barssince(currentBullPattern)
bearPatternBars = ta.barssince(currentBearPattern)
bullPatternRecent = not na(bullPatternBars) and bullPatternBars <= 3
bearPatternRecent = not na(bearPatternBars) and bearPatternBars <= 3
plotshape(showPatternMarkers and currentBullPattern,title="Bull S+ Pattern",style=shape.triangleup,location=location.belowbar,color=cBull,size=size.tiny,text="S+",textcolor=cText)
plotshape(showPatternMarkers and currentBearPattern,title="Bear S+ Pattern",style=shape.triangledown,location=location.abovebar,color=cBear,size=size.tiny,text="S+",textcolor=cText)
plotshape(showPatternMarkers and currentDojiPattern,title="Doji Warning",style=shape.circle,location=location.abovebar,color=cWarn,size=size.tiny,text="D",textcolor=cBlack)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 15) LIVE PROJECTION FACTORY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float rawGapLow = na
float rawGapHigh = na
if hasManipRange
    if close >= levelP2
        rawGapLow := levelP2
        rawGapHigh := levelP3
    else if close >= levelP1
        rawGapLow := levelP1
        rawGapHigh := levelP2
    else if close >= levelZ
        rawGapLow := levelZ
        rawGapHigh := levelP1
    else if close >= levelM1
        rawGapLow := levelM1
        rawGapHigh := levelZ
    else if close >= levelM2
        rawGapLow := levelM2
        rawGapHigh := levelM1
    else
        rawGapLow := levelM3
        rawGapHigh := levelM2
rawSide = officialContextSide
float rawEntry = na
if rawSide != 0 and hasManipRange
    rawEntry := entryModel == "Mid-Body 50%" ? (open+close)/2.0 : rawSide == 1 ? rawGapLow : rawGapHigh
rawStep = not na(ladderStep) ? math.abs(ladderStep) : na
rawTarget = rawSide == 1 and not na(rawEntry) ? rawEntry+rawStep*tpSteps : rawSide == -1 and not na(rawEntry) ? rawEntry-rawStep*tpSteps : na
rawStop = rawSide == 1 and not na(rawEntry) ? rawEntry-rawStep*slSteps : rawSide == -1 and not na(rawEntry) ? rawEntry+rawStep*slSteps : na
rawGapMid = not na(rawGapLow) and not na(rawGapHigh) ? (rawGapLow+rawGapHigh)/2.0 : na
rawGapTolerance = not na(rawStep) ? math.max(syminfo.mintick*2.0,rawStep*0.08) : syminfo.mintick*2.0
rawEntryInsideGap = not na(rawEntry) and not na(rawGapLow) and not na(rawGapHigh) and rawEntry >= rawGapLow-rawGapTolerance and rawEntry <= rawGapHigh+rawGapTolerance
rawRiskMapValid = rawSide != 0 and not na(rawEntry) and not na(rawTarget) and not na(rawStop) and (rawSide == 1 ? rawTarget > rawEntry and rawStop < rawEntry : rawTarget < rawEntry and rawStop > rawEntry)
rawMovementProgress = hasManipRange and rawSide != 0 ? f_clamp(rawSide == 1 ? (close-manipLow)/ladderRange*100.0 : (manipHigh-close)/ladderRange*100.0,0.0,150.0) : 0.0
rawTimingPaid = rawMovementProgress >= presetPaidProgress or (rawSide == 1 and not na(rawTarget) and close >= rawTarget) or (rawSide == -1 and not na(rawTarget) and close <= rawTarget)
rawTimingLate = not rawTimingPaid and rawMovementProgress >= presetLateProgress
bullSteps = math.sum((close > close[1] ? 1.0 : 0.0)+(low >= low[1] ? 1.0 : 0.0),3)
bearSteps = math.sum((close < close[1] ? 1.0 : 0.0)+(high <= high[1] ? 1.0 : 0.0),3)
bullIntent = bullSteps >= 3.6 and (not requireCorrectCenterSide or na(distCenter) or close >= distCenter)
bearIntent = bearSteps >= 3.6 and (not requireCorrectCenterSide or na(distCenter) or close <= distCenter)
rawIntentOK = rawSide == 1 ? bullIntent : rawSide == -1 ? bearIntent : false
rawCloseStrength = rng > 0 ? (rawSide == 1 ? (close-low)/rng*100.0 : rawSide == -1 ? (high-close)/rng*100.0 : 0.0) : 0.0
rawDirectionalCandleOK = rawSide == 1 ? close > open : rawSide == -1 ? close < open : false
rawScoutCandleOK = rawDirectionalCandleOK and bodyPct >= presetScoutBodyMin and rawCloseStrength >= presetScoutCloseMin
rawRoomDistance = rawSide == 1 ? rawTarget-close : rawSide == -1 ? close-rawTarget : na
rawRewardDistance = not na(rawTarget) and not na(rawEntry) ? math.abs(rawTarget-rawEntry) : na
rawRoomPct = not na(rawRoomDistance) and not na(rawRewardDistance) and rawRewardDistance > 0 ? f_clamp(rawRoomDistance/rawRewardDistance*100.0,0.0,150.0) : 0.0
rawScoutRoomOK = rawRoomPct >= presetScoutMinRoomPct

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 16) CALENDAR STORAGE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
CAL_NONE = 0
CAL_ARMED = 10
CAL_ACTIVE = 20
CAL_WIN = 1
CAL_LOSS = -1
CAL_AMBIGUOUS = 2
CAL_NO_ENTRY = 3
CAL_LATE = 5
CAL_INVALIDATED = 6
CAL_EXPIRED = 7
var array<bool> scoutDays = array.new_bool(372,false)
var array<int> scoutDirections = array.new_int(372,0)
var array<int> scoutTimes = array.new_int(372,-1)
var array<int> scoutResults = array.new_int(372,CAL_NONE)
var array<float> scoutPoints = array.new_float(372,0.0)
var array<bool> officialDays = array.new_bool(372,false)
var array<int> officialDirections = array.new_int(372,0)
var array<int> officialTimes = array.new_int(372,-1)
var array<int> officialResults = array.new_int(372,CAL_NONE)
var array<float> officialPoints = array.new_float(372,0.0)
var array<float> officialBrecha = array.new_float(372,0.0)
var array<float> officialConsensus = array.new_float(372,0.0)
calendarLatestYear = year(last_bar_time,tz)
calendarLatestMonth = month(last_bar_time,tz)
calendarDesiredYear = calendarMonthMode == "Manual Month" ? calendarManualYear : calendarLatestYear
calendarDesiredMonth = calendarMonthMode == "Manual Month" ? calendarManualMonth : calendarLatestMonth
var int calendarTrackedYear = na
if barstate.isfirst
    calendarTrackedYear := calendarDesiredYear
if calendarTrackedYear != calendarDesiredYear
    calendarTrackedYear := calendarDesiredYear
    for resetIndex = 0 to 371
        array.set(scoutDays,resetIndex,false)
        array.set(scoutDirections,resetIndex,0)
        array.set(scoutTimes,resetIndex,-1)
        array.set(scoutResults,resetIndex,CAL_NONE)
        array.set(scoutPoints,resetIndex,0.0)
        array.set(officialDays,resetIndex,false)
        array.set(officialDirections,resetIndex,0)
        array.set(officialTimes,resetIndex,-1)
        array.set(officialResults,resetIndex,CAL_NONE)
        array.set(officialPoints,resetIndex,0.0)
        array.set(officialBrecha,resetIndex,0.0)
        array.set(officialConsensus,resetIndex,0.0)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 17) SCOUT FREEZE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bool eventScoutFreeze = false
bool eventScoutTouch = false
bool eventScoutWin = false
bool eventScoutLoss = false
bool eventScoutAmbiguous = false
bool eventScoutNoEntry = false
bool eventScoutInvalid = false
bool eventScoutExpired = false
scoutBaseSafety = inDist and rawSide != 0 and hasManipRange and not contextInvalidated and rawRiskMapValid and rawEntryInsideGap and not rawTimingPaid and rawMovementProgress <= presetScoutMaxProgress
scoutEvidencePass = (not scoutRequireIntent or rawIntentOK) and (not scoutRequireStrongCandle or rawScoutCandleOK) and (not scoutRequireRoom or rawScoutRoomOK)
scoutFreezeReady = useScoutFreeze and scoutBaseSafety and scoutEvidencePass and barstate.isconfirmed and (not onlyTradeDistribution or inDist) and (not oneScoutPerDistribution or not scoutCreatedThisDistribution)
if scoutFreezeReady and scout.id == 0
    scout.id := nextScoutId
    nextScoutId += 1
    scout.side := rawSide
    scout.state := "FROZEN"
    scout.entry := rawEntry
    scout.target := rawTarget
    scout.stop := rawStop
    scout.step := rawStep
    scout.gapLow := rawGapLow
    scout.gapHigh := rawGapHigh
    scout.freezeBar := bar_index
    scout.touchBar := na
    scout.activeBar := na
    scout.expiryBar := presetScoutExpirationBars > 0 ? bar_index+presetScoutExpirationBars : na
    scout.freezeTime := time
    scout.reason := "SCOUT FROZEN · WAIT OFFICIAL CONFIRMATION"
    scout.result := "PENDING"
    scoutCreatedThisDistribution := true
    int sy = year(time,tz)
    int sm = month(time,tz)
    int sd = dayofmonth(time,tz)
    int sidx = sy == calendarTrackedYear ? (sm-1)*31+sd-1 : -1
    scout.ledgerIndex := sidx
    if sidx >= 0 and sidx <= 371
        array.set(scoutDays,sidx,true)
        array.set(scoutDirections,sidx,scout.side)
        array.set(scoutTimes,sidx,hour(time,tz)*60+minute(time,tz))
        array.set(scoutResults,sidx,CAL_ARMED)
        array.set(scoutPoints,sidx,0.0)
    eventScoutFreeze := true

// Evaluation levels become frozen Scout values as soon as Scout exists.
evalSide = scout.id > 0 ? scout.side : rawSide
evalEntry = scout.id > 0 ? scout.entry : rawEntry
evalTarget = scout.id > 0 ? scout.target : rawTarget
evalStop = scout.id > 0 ? scout.stop : rawStop
evalStep = scout.id > 0 ? scout.step : rawStep
evalGapLow = scout.id > 0 ? scout.gapLow : rawGapLow
evalGapHigh = scout.id > 0 ? scout.gapHigh : rawGapHigh
evalGapMid = not na(evalGapLow) and not na(evalGapHigh) ? (evalGapLow+evalGapHigh)/2.0 : na
evalEntryInsideGap = not na(evalEntry) and not na(evalGapLow) and not na(evalGapHigh) and evalEntry >= evalGapLow-math.max(syminfo.mintick*2.0,nz(evalStep,syminfo.mintick)*0.08) and evalEntry <= evalGapHigh+math.max(syminfo.mintick*2.0,nz(evalStep,syminfo.mintick)*0.08)
evalRiskMapValid = evalSide != 0 and not na(evalEntry) and not na(evalTarget) and not na(evalStop) and (evalSide == 1 ? evalTarget > evalEntry and evalStop < evalEntry : evalTarget < evalEntry and evalStop > evalEntry)
evalMovementProgress = hasManipRange and evalSide != 0 ? f_clamp(evalSide == 1 ? (close-manipLow)/ladderRange*100.0 : (manipHigh-close)/ladderRange*100.0,0.0,150.0) : 0.0
evalTimingPaid = evalMovementProgress >= presetPaidProgress or (evalSide == 1 and close >= evalTarget) or (evalSide == -1 and close <= evalTarget)
evalTimingLate = not evalTimingPaid and evalMovementProgress >= presetLateProgress
evalIntentOK = evalSide == 1 ? bullIntent : evalSide == -1 ? bearIntent : false
evalCloseStrength = rng > 0 ? (evalSide == 1 ? (close-low)/rng*100.0 : evalSide == -1 ? (high-close)/rng*100.0 : 0.0) : 0.0
armedDirectionOK = evalSide == 1 ? close > open : evalSide == -1 ? close < open : false
armedBodyOK = bodyPct >= presetBodyMin
armedCloseOK = evalCloseStrength >= presetCloseStrengthMin
wickBalanceOK = evalSide == 1 ? upperWickPct <= 30.0 : evalSide == -1 ? lowerWickPct <= 30.0 : false
expansionQualityOK = rng > ta.sma(rng,3) and bodyPct >= math.max(40.0,presetBodyMin-10.0)
priorHigh = ta.highest(high[1],presetStructureLookback)
priorLow = ta.lowest(low[1],presetStructureLookback)
bullStructureNow = inDist and barstate.isconfirmed and close > priorHigh+structureBuffer and low >= low[1]
bearStructureNow = inDist and barstate.isconfirmed and close < priorLow-structureBuffer and high <= high[1]
bullStructureBars = ta.barssince(bullStructureNow)
bearStructureBars = ta.barssince(bearStructureNow)
bullStructureRecent = not na(bullStructureBars) and bullStructureBars <= presetStructureMemory
bearStructureRecent = not na(bearStructureBars) and bearStructureBars <= presetStructureMemory
structureOK = evalSide == 1 ? bullStructureRecent : evalSide == -1 ? bearStructureRecent : false
microBOSNow = evalSide == 1 ? bullStructureNow : evalSide == -1 ? bearStructureNow : false
higherLowLowerHighOK = evalSide == 1 ? low > low[2] : evalSide == -1 ? high < high[2] : false
oppositeStructureFailureOK = evalSide == 1 ? not bearStructureRecent : evalSide == -1 ? not bullStructureRecent : false
pullbackStructureIntegrityOK = evalSide == 1 ? low >= ta.lowest(low[1],3) or close > close[1] : evalSide == -1 ? high <= ta.highest(high[1],3) or close < close[1] : false
rollingSweepLow = ta.lowest(low,5)
rollingSweepHigh = ta.highest(high,5)
buySweepSeen = evalSide == 1 and rollingSweepLow < evalEntry-structureBuffer
sellSweepSeen = evalSide == -1 and rollingSweepHigh > evalEntry+structureBuffer
sweepSeen = evalSide == 1 ? buySweepSeen : evalSide == -1 ? sellSweepSeen : false
reclaimEvent = evalSide == 1 ? buySweepSeen and close > evalEntry+reclaimBuffer : evalSide == -1 ? sellSweepSeen and close < evalEntry-reclaimBuffer : false
buyBreakRaw = ta.crossover(close,nz(evalEntry+structureBuffer,close))
sellBreakRaw = ta.crossunder(close,nz(evalEntry-structureBuffer,close))
buyBreakBars = ta.barssince(evalSide == 1 and buyBreakRaw)
sellBreakBars = ta.barssince(evalSide == -1 and sellBreakRaw)
breakRecent = evalSide == 1 ? not na(buyBreakBars) and buyBreakBars <= 4 : evalSide == -1 ? not na(sellBreakBars) and sellBreakBars <= 4 : false
breakHold = evalSide == 1 ? breakRecent and close > evalEntry+structureBuffer and (armedBodyOK or bullIntent) : evalSide == -1 ? breakRecent and close < evalEntry-structureBuffer and (armedBodyOK or bearIntent) : false
levelEventOK = reclaimEvent or breakHold
wickRejectionOK = evalSide == 1 ? lowerWickPct > upperWickPct*1.20 and close > open : evalSide == -1 ? upperWickPct > lowerWickPct*1.20 and close < open : false
triggerBuilding = sweepSeen or breakRecent or evalIntentOK
directionalBodySeries = evalSide == 1 ? (close > open ? body : 0.0) : evalSide == -1 ? (close < open ? body : 0.0) : 0.0
oppositeBodySeries = evalSide == 1 ? (close < open ? body : 0.0) : evalSide == -1 ? (close > open ? body : 0.0) : 0.0
directionalBodyAvg = ta.sma(directionalBodySeries,3)
oppositeBodyAvg = ta.sma(oppositeBodySeries,3)
weakOppositeBodyOK = nz(oppositeBodyAvg,0.0) <= math.max(nz(directionalBodyAvg,body)*0.70,syminfo.mintick)
controlledRetracementOK = not na(evalStep) and math.abs(close-evalEntry) <= evalStep*0.80
bodyOverlap = math.max(0.0,math.min(math.max(open,close),math.max(open[1],close[1]))-math.max(math.min(open,close),math.min(open[1],close[1])))
lowOverlapOK = body > 0 and bodyOverlap <= body*0.50
noOppositeEngulfingOK = evalSide == 1 ? not isBearEngulf : evalSide == -1 ? not isBullEngulf : false
healthyPullbackDurationOK = math.min(nz(buyBreakBars,99),nz(sellBreakBars,99)) <= 5 or structureOK
structureLow = ta.lowest(low,5)
structureHigh = ta.highest(high,5)
structuralSLOK = evalSide == 1 ? evalStop <= structureLow-structureBuffer : evalSide == -1 ? evalStop >= structureHigh+structureBuffer : false
stopBeyondWickClusterOK = evalSide == 1 ? evalStop <= ta.lowest(low,3) : evalSide == -1 ? evalStop >= ta.highest(high,3) : false
stopOutsideATROK = not na(evalStep) and evalStep*slSteps >= atr*0.50
stopOutsideArmedBodyOK = evalSide == 1 ? evalStop < low : evalSide == -1 ? evalStop > high : false
stopProtectedByLevelOK = evalSide == 1 ? evalStop < evalGapLow : evalSide == -1 ? evalStop > evalGapHigh : false
evalRoomDistance = evalSide == 1 ? evalTarget-close : evalSide == -1 ? close-evalTarget : na
evalRewardDistance = math.abs(evalTarget-evalEntry)
evalRoomPct = evalRewardDistance > 0 ? f_clamp(evalRoomDistance/evalRewardDistance*100.0,0.0,150.0) : 0.0
clearPathToTPOK = evalRoomPct >= presetMinRoomPct and not evalTimingPaid
noLiquidityWallOK = evalSide == 1 ? na(priorHigh) or evalTarget <= priorHigh+evalStep*0.20 : evalSide == -1 ? na(priorLow) or evalTarget >= priorLow-evalStep*0.20 : false
tpBeforeSessionBoundaryOK = hour(time,tz) < 12 or (hour(time,tz) == 12 and minute(time,tz) <= 30)
tpOutsideCongestionOK = evalSide == 1 ? evalTarget > ta.highest(close,3) : evalSide == -1 ? evalTarget < ta.lowest(close,3) : false
tpNextLiquidityOK = evalSide == 1 ? evalTarget <= distRangeHigh+evalStep*2.0 : evalSide == -1 ? evalTarget >= distRangeLow-evalStep*2.0 : false
bodyATR = atr > 0 ? body/atr : na
stepATR = atr > 0 and not na(evalStep) ? evalStep/atr : na
bodyATRQualityOK = not na(bodyATR) and bodyATR >= 0.20 and bodyATR <= 1.80
stepATRQualityOK = not na(stepATR) and stepATR <= 3.0
noAbnormalSpikeOK = atr > 0 and rng <= atr*2.25
compressionBeforeExpansionOK = ta.sma(rng[1],3) < atr and rng > ta.sma(rng[1],3)*1.10
stableDistributionRangeOK = atr > 0 and hasManipRange and ladderRange/atr >= 0.50 and ladderRange/atr <= 6.0
earlyProgressOK = evalMovementProgress <= 45.0
setupFreshnessOK = math.min(nz(buyBreakBars,99),nz(sellBreakBars,99)) <= 3 or (evalSide == 1 ? nz(bullStructureBars,99) <= 3 : nz(bearStructureBars,99) <= 3)
notPaidOK = not evalTimingPaid
notLateOK = not evalTimingLate and not evalTimingPaid
onePlanAvailableOK = not onePlanPerDistribution or not officialCreatedThisDistribution
noOppositeShiftOK = evalSide == 1 ? not bearStructureNow : evalSide == -1 ? not bullStructureNow : false
noOppositePatternOK = evalSide == 1 ? not currentBearPattern : evalSide == -1 ? not currentBullPattern : false
directionRemainsValidOK = not contextInvalidated and evalSide != 0 and evalSide == lockedDirection
triggerLevelValidOK = levelEventOK or triggerBuilding
planIntactBeforeEntryOK = evalEntryInsideGap and structuralSLOK and not evalTimingLate and not evalTimingPaid and not contextInvalidated
premiumDiscountOK = evalSide == 1 ? evalEntry <= evalGapMid : evalSide == -1 ? evalEntry >= evalGapMid : false
outsideCongestionOK = ta.stdev(close,5) > syminfo.mintick*2.0
imbalanceAlignedOK = levelEventOK and armedDirectionOK and armedBodyOK
notOverextendedOK = evalMovementProgress <= presetMaxProgress
beforeArmPatternOK = evalSide == 1 ? bullPatternRecent : evalSide == -1 ? bearPatternRecent : false
trendAgreementOK = evalSide == 1 ? supertrendBull and localEMA20 >= localEMA50 : evalSide == -1 ? supertrendBear and localEMA20 <= localEMA50 : false
scoutEntryTouchedNow = scout.id > 0 and scout.state == "FROZEN" and bar_index > nz(scout.freezeBar,bar_index) and (scout.side == 1 ? low <= scout.entry+entryTolerance : high >= scout.entry-entryTolerance)
entryUntouchedNow = scout.id > 0 ? scout.state == "FROZEN" and not scoutEntryTouchedNow : false

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 18) BRECHA AUTHORITY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bA01 = profileCustom ? b01 : false
bA02 = profileCustom ? b02 : profilePrecision
bA03 = profileCustom ? b03 : true
bA04 = profileCustom ? b04 : false
bA05 = profileCustom ? b05 : false
bA06 = profileCustom ? b06 : true
bA07 = profileCustom ? b07 : true
bA08 = profileCustom ? b08 : not profileProfit
bA09 = profileCustom ? b09 : false
bA10 = profileCustom ? b10 : profilePrecision
