scoutRequireRoom = input.bool(true, "Scout Requires Remaining TP Room", group=gScout)
scoutCancelOnInvalidation = input.bool(true, "Cancel Pending Scout On Context Invalidation", group=gScout)
promoteSameScoutOnly = input.bool(true, "Official Must Promote Same Frozen Scout", group=gScout)
showScoutMarkers = input.bool(true, "Show Scout Freeze / Result Markers", group=gScout)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
