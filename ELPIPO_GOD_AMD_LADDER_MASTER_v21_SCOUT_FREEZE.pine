bA17 = profileCustom ? b17 : profilePrecision
bA18 = profileCustom ? b18 : profileProfit
bA19 = profileCustom ? b19 : false
bA20 = profileCustom ? b20 : false
bA21 = profileCustom ? b21 : not profileProfit
bA22 = profileCustom ? b22 : false
bA23 = profileCustom ? b23 : false
