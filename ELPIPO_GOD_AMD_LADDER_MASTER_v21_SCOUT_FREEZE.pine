cA50 = profileCustom ? c50 : profilePrecision
array<bool> cEnabled = array.from(cA01,cA02,cA03,cA04,cA05,cA06,cA07,cA08,cA09,cA10,cA11,cA12,cA13,cA14,cA15,cA16,cA17,cA18,cA19,cA20,cA21,cA22,cA23,cA24,cA25,cA26,cA27,cA28,cA29,cA30,cA31,cA32,cA33,cA34,cA35,cA36,cA37,cA38,cA39,cA40,cA41,cA42,cA43,cA44,cA45,cA46,cA47,cA48,cA49,cA50)
array<bool> cPassed = array.from(consensusDirectionMatch,consensusPredictorEdgeOK,consensusComboEdgeOK,consensusAMDYellowAgreementOK,consensusPsychBiasOK,consensusBrechaLadderOK,consensusBrechaPsychOK,consensusPatternOK,consensusTrendOK,consensusFinalActionOK,consensusHTFDirectionOK,consensusHTFStructureOK,consensusHTFLiquidityOK,consensusHTFStrengthOK,consensusLTFTriggerOK,consensusTrendRegimeOK,consensusNoChopOK,consensusVolatilityRegimeOK,consensusExpansionRegimeOK,consensusNoMeanReversionConflictOK,consensusSessionPhaseOK,consensusLeadOK,entryUntouchedNow,consensusFreshnessOK,consensusExpirationOK,evalRiskMapValid and clearPathToTPOK,consensusSLEfficiencyOK,consensusTPObstacleOK,consensusSameBarRiskOK,consensusGapThroughRiskOK,consensusStrongPredictorOK,consensusStrongComboOK,consensusSessionProbabilityOK,consensusRegimeProbabilityOK,consensusEntryDepthOK,consensusNoDirectionConflictOK,consensusNoContextConflictOK,consensusNoPatternConflictOK,consensusNoVolatilityConflictOK,consensusNoTimingConflictOK,consensusDualYellowStrengthOK,consensusFalseBalanceOK,consensusSilentEdgeOK,consensusTrapProbabilityOK,consensusAsymmetryOK,not contextInvalidated,consensusPlanStillQualifiedOK,consensusNoOppAuthoritySurgeOK,consensusEntryDistanceOK,consensusNotStaleOK)
[consensusEnabledCount,consensusPassedCount,consensusAuthorityPct,consensusCategoriesActive,consensusCategoriesPassed,consensusCategoryText,consensusMissingText] = f_authority(cEnabled,cPassed,"CONSENSUS")
consensusFoundationPass = (not cA01 or array.get(cPassed,0)) and (not cA23 or array.get(cPassed,22)) and (not cA26 or array.get(cPassed,25))
consensusVetoPass = (not cA17 or array.get(cPassed,16)) and (not cA29 or array.get(cPassed,28)) and (not cA36 or array.get(cPassed,35)) and (not cA40 or array.get(cPassed,39)) and (not cA46 or array.get(cPassed,45)) and (not cA50 or array.get(cPassed,49))
consensusQualified = consensusEnabledCount > 0 and consensusFoundationPass and consensusVetoPass and consensusAuthorityPct >= presetAuthorityMinConsensus and consensusCategoriesPassed >= math.min(presetCategoryQuorumConsensus,consensusCategoriesActive)
consensusGatePass = not useConsensusVeto or not consensusRequiredByProfile or consensusQualified
consensusStatus = not useConsensusVeto ? "VETO OFF" : consensusEnabledCount == 0 ? "PROFILE DOES NOT REQUIRE" : consensusQualified ? "CONFIRMED" : not consensusFoundationPass ? "FOUNDATION BLOCK" : not consensusVetoPass ? "ACTIVE VETO" : "WAIT CROSS-ENGINE EVIDENCE"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 20) OFFICIAL PROMOTION — SAME SCOUT, SAME LEVELS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bool eventOfficialArm = false
bool eventOfficialTouch = false
bool eventOfficialActive = false
bool eventOfficialWin = false
bool eventOfficialLoss = false
bool eventOfficialAmbiguous = false
bool eventOfficialNoEntry = false
bool eventOfficialInvalid = false
bool eventOfficialExpired = false
bool eventOfficialLate = false
brechaGatePass = not useBrechaGate or brechaQualified
officialArmSafety = inDist and scout.id > 0 and scout.state == "FROZEN" and not scoutEntryTouchedNow and not contextInvalidated and evalRiskMapValid and evalEntryInsideGap and (not blockPaidPlans or not evalTimingPaid) and (not blockLatePlans or not evalTimingLate)
officialArmReady = officialArmSafety and brechaGatePass and consensusGatePass and barstate.isconfirmed and (not onlyTradeDistribution or inDist) and (not onePlanPerDistribution or not officialCreatedThisDistribution)
if officialArmReady and official.id == 0
    official.id := nextOfficialId
    nextOfficialId += 1
    official.scoutId := scout.id
    official.side := scout.side
    official.state := "ARMED"
    official.source := consensusRequiredByProfile ? "SCOUT + BRECHA + CONSENSUS" : "SCOUT + BRECHA"
    official.entry := scout.entry
    official.target := scout.target
    official.stop := scout.stop
    official.step := scout.step
    official.armBar := bar_index
    official.expiryBar := math.min(nz(scout.expiryBar,bar_index+presetOfficialExpirationBars),bar_index+presetOfficialExpirationBars)
    official.armTime := time
    official.brechaAuthority := brechaAuthorityPct
    official.consensusAuthority := consensusAuthorityPct
    official.reason := "SAME SCOUT PROMOTED · WAIT ENTRY + ACCEPTANCE"
    official.result := "PENDING"
    officialCreatedThisDistribution := true
    official.ledgerIndex := scout.ledgerIndex
    if official.ledgerIndex >= 0 and official.ledgerIndex <= 371
        array.set(officialDays,official.ledgerIndex,true)
        array.set(officialDirections,official.ledgerIndex,official.side)
        array.set(officialTimes,official.ledgerIndex,hour(time,tz)*60+minute(time,tz))
        array.set(officialResults,official.ledgerIndex,CAL_ARMED)
        array.set(officialPoints,official.ledgerIndex,0.0)
        array.set(officialBrecha,official.ledgerIndex,official.brechaAuthority)
        array.set(officialConsensus,official.ledgerIndex,official.consensusAuthority)
    eventOfficialArm := true

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 21) SCOUT + OFFICIAL STATE MACHINES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var int officialAcceptanceCount = 0
if distStart
    officialAcceptanceCount := 0
scoutTargetTouched = scout.id > 0 and (scout.side == 1 ? high >= scout.target : low <= scout.target)
scoutStopTouched = scout.id > 0 and (scout.side == 1 ? low <= scout.stop : high >= scout.stop)
scoutLeadReady = not scoutEntryStartsNextBar or bar_index > nz(scout.freezeBar,bar_index)
scoutExpiredNow = scout.state == "FROZEN" and not na(scout.expiryBar) and bar_index > scout.expiryBar
if scout.state == "FROZEN" and bar_index > nz(scout.freezeBar,bar_index-1)
    if scoutCancelOnInvalidation and contextInvalidated
        scout.state := "INVALIDATED"
        scout.reason := "CONTEXT INVALIDATED BEFORE SCOUT ENTRY"
        scout.result := "NO TRADE"
        eventScoutInvalid := true
    else if scoutExpiredNow
        scout.state := "EXPIRED"
        scout.reason := "SCOUT ENTRY WINDOW EXPIRED"
        scout.result := "NO ENTRY"
        eventScoutExpired := true
    else if scoutTargetTouched and not scoutEntryTouchedNow
        scout.state := "NO ENTRY"
        scout.reason := "TARGET REACHED BEFORE SCOUT ENTRY"
        scout.result := "NO ENTRY"
        eventScoutNoEntry := true
    else if scoutEntryTouchedNow and scoutLeadReady and trackScoutResults
        scout.touchBar := bar_index
        scout.activeBar := bar_index
        eventScoutTouch := true
        if scoutTargetTouched or scoutStopTouched
            if sameBarPolicy == "Conservative Loss"
                scout.state := "LOSS"
                scout.reason := "SCOUT ENTRY + EXIT SAME BAR · LOSS"
                scout.result := "LOSS"
                eventScoutLoss := true
            else
                scout.state := "AMBIGUOUS"
                scout.reason := "SCOUT ENTRY + TP/SL SAME BAR · UNKNOWN ORDER"
                scout.result := "AMBIGUOUS"
                eventScoutAmbiguous := true
        else
            scout.state := "ACTIVE"
            scout.reason := "EARLY SCOUT ENTRY ACTIVE"
            scout.result := "ACTIVE"
        if official.id == 0 and not officialLateRecordedThisDistribution
            officialLateRecordedThisDistribution := true
            eventOfficialLate := true
            if scout.ledgerIndex >= 0 and scout.ledgerIndex <= 371
                array.set(officialDays,scout.ledgerIndex,true)
                array.set(officialDirections,scout.ledgerIndex,scout.side)
                array.set(officialTimes,scout.ledgerIndex,hour(time,tz)*60+minute(time,tz))
                array.set(officialResults,scout.ledgerIndex,CAL_LATE)
                array.set(officialPoints,scout.ledgerIndex,0.0)
if scout.state == "ACTIVE" and bar_index > nz(scout.activeBar,bar_index)
    if scoutTargetTouched and scoutStopTouched
        if sameBarPolicy == "Conservative Loss"
            scout.state := "LOSS"
            scout.reason := "SCOUT TP + SL SAME BAR · LOSS"
            scout.result := "LOSS"
            eventScoutLoss := true
        else
            scout.state := "AMBIGUOUS"
            scout.reason := "SCOUT TP + SL SAME BAR · UNKNOWN ORDER"
            scout.result := "AMBIGUOUS"
            eventScoutAmbiguous := true
    else if scoutTargetTouched
        scout.state := "WIN"
        scout.reason := "SCOUT TP HIT"
        scout.result := "WIN"
        eventScoutWin := true
    else if scoutStopTouched
        scout.state := "LOSS"
        scout.reason := "SCOUT SL HIT"
        scout.result := "LOSS"
        eventScoutLoss := true

bool officialEntryTouched = f_official_pending(official.state) and (official.side == 1 ? low <= official.entry+entryTolerance : high >= official.entry-entryTolerance)
bool officialTargetTouched = official.id > 0 and (official.side == 1 ? high >= official.target : low <= official.target)
bool officialStopTouched = official.id > 0 and (official.side == 1 ? low <= official.stop : high >= official.stop)
bool officialAcceptanceClose = official.side == 1 ? close > official.entry+reclaimBuffer and close > open and bodyPct >= presetBodyMin and (not requireCorrectCenterSide or close >= distCenter) : official.side == -1 ? close < official.entry-reclaimBuffer and close < open and bodyPct >= presetBodyMin and (not requireCorrectCenterSide or close <= distCenter) : false
bool officialIntentOK = official.side == 1 ? bullIntent : official.side == -1 ? bearIntent : false
if f_official_pending(official.state) and barstate.isconfirmed
    officialAcceptanceCount := officialAcceptanceClose and officialIntentOK ? officialAcceptanceCount+1 : 0
officialAcceptanceReady = not requireAcceptance or officialAcceptanceCount >= presetAcceptanceCloses
officialLeadReady = not requireNextBarEntry or bar_index > nz(official.armBar,bar_index)
officialExpiredNow = f_official_pending(official.state) and not na(official.expiryBar) and bar_index > official.expiryBar
if official.state == "ARMED" and bar_index > nz(official.armBar,bar_index-1)
    if cancelOnContextInvalidation and contextInvalidated
        official.state := "INVALIDATED"
        official.reason := "CONTEXT INVALIDATED · NO AUTO-REVERSAL"
        official.result := "NO TRADE"
        eventOfficialInvalid := true
    else if officialExpiredNow
        official.state := "EXPIRED"
        official.reason := "OFFICIAL ENTRY WINDOW EXPIRED"
        official.result := "NO ENTRY"
        eventOfficialExpired := true
    else if officialTargetTouched and not officialEntryTouched
        official.state := "NO ENTRY"
        official.reason := "TARGET REACHED BEFORE OFFICIAL ENTRY"
        official.result := "NO ENTRY"
        eventOfficialNoEntry := true
    else if officialEntryTouched and officialLeadReady
        official.touchBar := bar_index
        eventOfficialTouch := true
        if officialTargetTouched or officialStopTouched
            if sameBarPolicy == "Conservative Loss"
                official.state := "LOSS"
                official.reason := "OFFICIAL ENTRY + EXIT SAME BAR · LOSS"
                official.result := "LOSS"
                eventOfficialLoss := true
            else
                official.state := "AMBIGUOUS"
                official.reason := "OFFICIAL ENTRY + TP/SL SAME BAR · UNKNOWN ORDER"
                official.result := "AMBIGUOUS"
                eventOfficialAmbiguous := true
        else if officialAcceptanceReady
            official.state := "ACTIVE"
            official.activeBar := bar_index
            official.reason := "OFFICIAL TOUCH + ACCEPTANCE CONFIRMED"
            official.result := "ACTIVE"
            eventOfficialActive := true
        else
            official.state := "TOUCHED"
            official.reason := "TOUCH IS NOT ENTRY · WAIT ACCEPTANCE"
if official.state == "TOUCHED"
    if cancelOnContextInvalidation and contextInvalidated
        official.state := "INVALIDATED"
        official.reason := "CONTEXT FAILED BEFORE ACCEPTANCE"
        official.result := "NO TRADE"
        eventOfficialInvalid := true
    else if officialExpiredNow
        official.state := "EXPIRED"
        official.reason := "NO ACCEPTANCE BEFORE EXPIRATION"
        official.result := "NO ENTRY"
        eventOfficialExpired := true
    else if officialTargetTouched
        official.state := "NO ENTRY"
        official.reason := "MOVE LEFT WITHOUT ACCEPTANCE"
        official.result := "NO ENTRY"
        eventOfficialNoEntry := true
    else if officialAcceptanceReady and barstate.isconfirmed
        official.state := "ACTIVE"
        official.activeBar := bar_index
        official.reason := "ACCEPTANCE CONFIRMED AFTER TOUCH"
        official.result := "ACTIVE"
        eventOfficialActive := true
    else if bar_index-nz(official.touchBar,bar_index) > 2
        official.state := "INVALIDATED"
        official.reason := "TOUCH FAILED TO BUILD ACCEPTANCE"
        official.result := "NO TRADE"
        eventOfficialInvalid := true
if official.state == "ACTIVE" and bar_index > nz(official.activeBar,bar_index)
    if officialTargetTouched and officialStopTouched
        if sameBarPolicy == "Conservative Loss"
            official.state := "LOSS"
            official.reason := "OFFICIAL TP + SL SAME BAR · LOSS"
            official.result := "LOSS"
            eventOfficialLoss := true
        else
            official.state := "AMBIGUOUS"
            official.reason := "OFFICIAL TP + SL SAME BAR · UNKNOWN ORDER"
            official.result := "AMBIGUOUS"
            eventOfficialAmbiguous := true
    else if officialTargetTouched
        official.state := "WIN"
        official.reason := "OFFICIAL TP HIT"
        official.result := "WIN"
        eventOfficialWin := true
    else if officialStopTouched
        official.state := "LOSS"
        official.reason := "OFFICIAL SL HIT"
        official.result := "LOSS"
        eventOfficialLoss := true
if distEnd
    if scout.state == "FROZEN"
        scout.state := "NO ENTRY"
        scout.reason := "DISTRIBUTION ENDED BEFORE SCOUT ENTRY"
        scout.result := "NO ENTRY"
        eventScoutNoEntry := true
    else if scout.state == "ACTIVE"
        scout.state := "EXPIRED"
        scout.reason := "DISTRIBUTION ENDED · SCOUT UNRESOLVED"
        scout.result := "UNRESOLVED"
        eventScoutExpired := true
    if official.state == "ARMED" or official.state == "TOUCHED"
        official.state := "NO ENTRY"
        official.reason := "DISTRIBUTION ENDED BEFORE OFFICIAL ACTIVE ENTRY"
        official.result := "NO ENTRY"
        eventOfficialNoEntry := true
    else if official.state == "ACTIVE"
        official.state := "EXPIRED"
        official.reason := "DISTRIBUTION ENDED · OFFICIAL UNRESOLVED"
        official.result := "UNRESOLVED"
        eventOfficialExpired := true

// Ledger consumes Scout events.
if scout.ledgerIndex >= 0 and scout.ledgerIndex <= 371
    if scout.state == "ACTIVE"
        array.set(scoutResults,scout.ledgerIndex,CAL_ACTIVE)
    if eventScoutWin
        array.set(scoutResults,scout.ledgerIndex,CAL_WIN)
        array.set(scoutPoints,scout.ledgerIndex,tpSteps)
    if eventScoutLoss
        array.set(scoutResults,scout.ledgerIndex,CAL_LOSS)
        array.set(scoutPoints,scout.ledgerIndex,-slSteps)
    if eventScoutAmbiguous
        array.set(scoutResults,scout.ledgerIndex,CAL_AMBIGUOUS)
    if eventScoutNoEntry
        array.set(scoutResults,scout.ledgerIndex,CAL_NO_ENTRY)
    if eventScoutInvalid
        array.set(scoutResults,scout.ledgerIndex,CAL_INVALIDATED)
    if eventScoutExpired
        array.set(scoutResults,scout.ledgerIndex,CAL_EXPIRED)
// Ledger consumes Official events.
if official.ledgerIndex >= 0 and official.ledgerIndex <= 371
    if eventOfficialActive
        array.set(officialResults,official.ledgerIndex,CAL_ACTIVE)
    if eventOfficialWin
        array.set(officialResults,official.ledgerIndex,CAL_WIN)
        array.set(officialPoints,official.ledgerIndex,tpSteps)
    if eventOfficialLoss
        array.set(officialResults,official.ledgerIndex,CAL_LOSS)
        array.set(officialPoints,official.ledgerIndex,-slSteps)
    if eventOfficialAmbiguous
        array.set(officialResults,official.ledgerIndex,CAL_AMBIGUOUS)
    if eventOfficialNoEntry
        array.set(officialResults,official.ledgerIndex,CAL_NO_ENTRY)
    if eventOfficialInvalid
        array.set(officialResults,official.ledgerIndex,CAL_INVALIDATED)
    if eventOfficialExpired
        array.set(officialResults,official.ledgerIndex,CAL_EXPIRED)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 22) LADDER + PLAN MAP
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
hasLadderVisual = hasManipRange and (inDist or (showLadderPreview and inManip and not na(manipYBody)))
gridLeft = inDist and not na(distLeftBar) ? distLeftBar : not na(manipLeftBar) ? manipLeftBar : bar_index
gridRight = inDist ? bar_index+gridRightBars : bar_index+previewBars
gridLabelX = gridRight+1
displayOfficial = official.id > 0 and not na(official.entry)
displayScout = not displayOfficial and showScoutPlan and scout.id > 0 and not na(scout.entry)
displayLive = not displayOfficial and not displayScout and showLiveProjection and inDist and rawRiskMapValid
displayPlan = displayOfficial or displayScout or displayLive
displaySide = displayOfficial ? official.side : displayScout ? scout.side : rawSide
displayEntry = displayOfficial ? official.entry : displayScout ? scout.entry : rawEntry
displayTarget = displayOfficial ? official.target : displayScout ? scout.target : rawTarget
displayStop = displayOfficial ? official.stop : displayScout ? scout.stop : rawStop
displayState = displayOfficial ? official.state : displayScout ? scout.state : "LIVE PROJECTION"
displaySource = displayOfficial ? "OFFICIAL #"+str.tostring(official.id)+" · SCOUT #"+str.tostring(official.scoutId) : displayScout ? "SCOUT #"+str.tostring(scout.id)+" · FROZEN" : "LIVE PROJECTION · MOVING"
displayLineStyle = displayOfficial ? "Solid" : displayScout ? "Dashed" : "Dotted"
displayTolerance = syminfo.mintick*2.0
f_price_role(float levelPrice) =>
    bool entryMatch = displayPlan and not na(levelPrice) and math.abs(levelPrice-displayEntry) <= displayTolerance
    bool targetMatch = displayPlan and not na(levelPrice) and math.abs(levelPrice-displayTarget) <= displayTolerance
    bool stopMatch = displayPlan and not na(levelPrice) and math.abs(levelPrice-displayStop) <= displayTolerance
    entryMatch ? 1 : targetMatch ? 2 : stopMatch ? 3 : 0
f_role_color(int role) => role == 1 ? color.white : role == 2 ? cBull : role == 3 ? cBear : gridIdle
if showLadder and hasLadderVisual
    array<float> levelPrices = array.from(levelP3,levelP2,levelP1,levelZ,levelM1,levelM2,levelM3)
    array<string> levelTexts = array.from("+3","+2","+1","0","-1","-2","-3")
    for levelIndex = 0 to 6
        float levelPrice = array.get(levelPrices,levelIndex)
        int role = f_price_role(levelPrice)
        color levelColor = f_role_color(role)
        int levelWidth = role > 0 ? activeLineWidth : inactiveLineWidth
        line levelLine = array.get(ladderLines,levelIndex)
        label levelLabel = array.get(ladderLabels,levelIndex)
        if na(levelLine)
            levelLine := line.new(gridLeft,levelPrice,gridRight,levelPrice,xloc=xloc.bar_index,color=levelColor,width=levelWidth,style=line.style_dotted)
            array.set(ladderLines,levelIndex,levelLine)
        else
            f_update_line(levelLine,gridLeft,gridRight,levelPrice,levelColor,levelWidth,"Dotted")
        if showLevelLabels
            string roleText = role == 1 ? " · ENTRY" : role == 2 ? " · TP" : role == 3 ? " · SL" : ""
            string fullText = array.get(levelTexts,levelIndex)+roleText+" · "+f_price(levelPrice)
            if na(levelLabel)
                levelLabel := label.new(gridLabelX,levelPrice,fullText,xloc=xloc.bar_index,style=label.style_label_left,textcolor=levelColor,color=color.new(cBlack,12),size=chartTextSize)
                array.set(ladderLabels,levelIndex,levelLabel)
            else
                f_update_label(levelLabel,gridLabelX,levelPrice,fullText,levelColor)
else
    for levelIndex = 0 to 6
        line levelLine = array.get(ladderLines,levelIndex)
        label levelLabel = array.get(ladderLabels,levelIndex)
        if not na(levelLine)
            line.delete(levelLine)
            array.set(ladderLines,levelIndex,na)
        if not na(levelLabel)
            label.delete(levelLabel)
            array.set(ladderLabels,levelIndex,na)
if showTradeMap and displayPlan
    if na(planEntryLine)
        planEntryLine := line.new(gridLeft,displayEntry,gridRight,displayEntry,xloc=xloc.bar_index,color=color.white,width=activeLineWidth,style=displayOfficial ? line.style_solid : displayScout ? line.style_dashed : line.style_dotted)
        planTargetLine := line.new(gridLeft,displayTarget,gridRight,displayTarget,xloc=xloc.bar_index,color=cBull,width=activeLineWidth,style=displayOfficial ? line.style_solid : displayScout ? line.style_dashed : line.style_dotted)
        planStopLine := line.new(gridLeft,displayStop,gridRight,displayStop,xloc=xloc.bar_index,color=cBear,width=activeLineWidth,style=displayOfficial ? line.style_solid : displayScout ? line.style_dashed : line.style_dotted)
    else
        f_update_line(planEntryLine,gridLeft,gridRight,displayEntry,color.white,activeLineWidth,displayLineStyle)
        f_update_line(planTargetLine,gridLeft,gridRight,displayTarget,cBull,activeLineWidth,displayLineStyle)
        f_update_line(planStopLine,gridLeft,gridRight,displayStop,cBear,activeLineWidth,displayLineStyle)
    if showTradeMapLabels
        int tagX = gridRight+4
        string entryTag = displaySource+" · ENTRY · "+f_price(displayEntry)
        string targetTag = "TP · +"+str.tostring(tpSteps)+" STEPS · "+f_price(displayTarget)
        string stopTag = "SL · -"+str.tostring(slSteps)+" STEPS · "+f_price(displayStop)
        if na(planEntryLabel)
            planEntryLabel := label.new(tagX,displayEntry,entryTag,xloc=xloc.bar_index,style=label.style_label_left,textcolor=color.white,color=color.new(cBlack,8),size=chartTextSize)
            planTargetLabel := label.new(tagX,displayTarget,targetTag,xloc=xloc.bar_index,style=label.style_label_left,textcolor=cBull,color=color.new(cBlack,8),size=chartTextSize)
            planStopLabel := label.new(tagX,displayStop,stopTag,xloc=xloc.bar_index,style=label.style_label_left,textcolor=cBear,color=color.new(cBlack,8),size=chartTextSize)
        else
            f_update_label(planEntryLabel,tagX,displayEntry,entryTag,color.white)
            f_update_label(planTargetLabel,tagX,displayTarget,targetTag,cBull)
            f_update_label(planStopLabel,tagX,displayStop,stopTag,cBear)
else
    if not na(planEntryLine)
        line.delete(planEntryLine)
        planEntryLine := na
    if not na(planTargetLine)
        line.delete(planTargetLine)
        planTargetLine := na
    if not na(planStopLine)
        line.delete(planStopLine)
        planStopLine := na
    if not na(planEntryLabel)
        label.delete(planEntryLabel)
        planEntryLabel := na
    if not na(planTargetLabel)
        label.delete(planTargetLabel)
        planTargetLabel := na
    if not na(planStopLabel)
        label.delete(planStopLabel)
        planStopLabel := na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 23) PIP DIMENSIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
pipUnit = syminfo.type == "forex" and (syminfo.mintick == 0.00001 or syminfo.mintick == 0.001) ? syminfo.mintick*10.0 : syminfo.mintick
f_update_dimension(int dimensionIndex,float y1,float y2,int x,string txt,color col) =>
    int baseLineIndex = dimensionIndex*3
    line mainLine = array.get(dimensionLines,baseLineIndex)
    line topTick = array.get(dimensionLines,baseLineIndex+1)
    line bottomTick = array.get(dimensionLines,baseLineIndex+2)
    label dimLabel = array.get(dimensionLabels,dimensionIndex)
    if na(mainLine)
        mainLine := line.new(x,y1,x,y2,xloc=xloc.bar_index,color=col,width=1)
        topTick := line.new(x-1,y1,x+1,y1,xloc=xloc.bar_index,color=col,width=1)
        bottomTick := line.new(x-1,y2,x+1,y2,xloc=xloc.bar_index,color=col,width=1)
        dimLabel := label.new(x,(y1+y2)/2.0,txt,xloc=xloc.bar_index,style=label.style_label_center,textcolor=col,color=color.new(cBlack,18),size=chartTextSize)
        array.set(dimensionLines,baseLineIndex,mainLine)
        array.set(dimensionLines,baseLineIndex+1,topTick)
        array.set(dimensionLines,baseLineIndex+2,bottomTick)
        array.set(dimensionLabels,dimensionIndex,dimLabel)
    else
        line.set_xy1(mainLine,x,y1)
        line.set_xy2(mainLine,x,y2)
        line.set_xy1(topTick,x-1,y1)
        line.set_xy2(topTick,x+1,y1)
        line.set_xy1(bottomTick,x-1,y2)
        line.set_xy2(bottomTick,x+1,y2)
        label.set_x(dimLabel,x)
        label.set_y(dimLabel,(y1+y2)/2.0)
        label.set_text(dimLabel,txt)
f_clear_dimensions() =>
    for i = 0 to 17
        line ln = array.get(dimensionLines,i)
        if not na(ln)
            line.delete(ln)
            array.set(dimensionLines,i,na)
    for i = 0 to 5
        label lb = array.get(dimensionLabels,i)
        if not na(lb)
            label.delete(lb)
            array.set(dimensionLabels,i,na)
if barstate.islast
    if showPipDimensions and showLadder and hasLadderVisual and pipUnit > 0
        float onePips = math.abs(levelP1-levelZ)/pipUnit
        float twoPips = math.abs(levelP2-levelZ)/pipUnit
        float threePips = math.abs(levelP3-levelZ)/pipUnit
        f_update_dimension(0,levelZ,levelP1,gridRight+8,str.tostring(onePips,"#.##"),color.white)
        f_update_dimension(1,levelZ,levelM1,gridRight+8,str.tostring(onePips,"#.##"),color.white)
        f_update_dimension(2,levelZ,levelP2,gridRight+14,str.tostring(twoPips,"#.##"),cTeal)
        f_update_dimension(3,levelZ,levelM2,gridRight+14,str.tostring(twoPips,"#.##"),cTeal)
        f_update_dimension(4,levelZ,levelP3,gridRight+20,str.tostring(threePips,"#.##"),cYellow)
        f_update_dimension(5,levelZ,levelM3,gridRight+20,str.tostring(threePips,"#.##"),cYellow)
    else
        f_clear_dimensions()

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 24) GOD PANEL + CALENDAR
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var table tMaster = table.new(f_pos(masterWindowPosInput),4,40,border_width=0,frame_width=0,bgcolor=color.new(cBlack,100))
var table tCalendar = table.new(f_pos(calendarPositionInput),7,12,border_width=1,frame_width=1,frame_color=color.rgb(55,68,91),bgcolor=color.new(cBlack,100))
f_initialize_tables() =>
    for r = 0 to 39
        if r != 3 and r != 8 and r != 14 and r != 20 and r != 26 and r != 32 and r != 37
            table.merge_cells(tMaster,0,r,3,r)
    table.merge_cells(tMaster,0,3,2,3)
    table.merge_cells(tMaster,0,8,2,8)
    table.merge_cells(tMaster,0,14,2,14)
    table.merge_cells(tMaster,0,20,2,20)
    table.merge_cells(tMaster,0,26,2,26)
    table.merge_cells(tMaster,0,32,2,32)
    table.merge_cells(tMaster,0,37,2,37)
    table.merge_cells(tCalendar,0,0,6,0)
    table.merge_cells(tCalendar,0,1,6,1)
    table.merge_cells(tCalendar,0,2,6,2)
    table.merge_cells(tCalendar,0,3,6,3)
    table.merge_cells(tCalendar,0,11,6,11)

f_result_symbol(int result) => result == CAL_WIN ? "✓" : result == CAL_LOSS ? "×" : result == CAL_AMBIGUOUS ? "?" : result == CAL_NO_ENTRY ? "—" : result == CAL_LATE ? "L" : result == CAL_INVALIDATED ? "I" : result == CAL_EXPIRED ? "E" : result == CAL_ARMED ? "A" : result == CAL_ACTIVE ? "●" : " "
f_result_bg(int result) => result == CAL_WIN ? cBullDark : result == CAL_LOSS ? cBearDark : result == CAL_AMBIGUOUS ? color.rgb(170,111,30) : result == CAL_LATE ? cIdle : result == CAL_INVALIDATED ? cInvalid : result == CAL_EXPIRED ? color.rgb(69,70,82) : result == CAL_ARMED ? cScout : result == CAL_ACTIVE ? cActive : color.rgb(14,20,31)

f_render_master() =>
    table.clear(tMaster,0,0,3,39)
    color sideAccent = officialContextSide == 1 ? cBull : officialContextSide == -1 ? cBear : cWarn
    color sideDark = officialContextSide == 1 ? cBullDark : officialContextSide == -1 ? cBearDark : cIdle
    string sessionText = inDist ? "DISTRIBUTION" : inManip ? "MANIPULATION" : inAccum ? "ACCUMULATION" : "OFF SESSION"
    string actionMain = official.state == "ACTIVE" ? "ACTIVE "+f_side(official.side) : official.state == "TOUCHED" ? "WAIT "+f_side(official.side)+" ACCEPTANCE" : official.state == "ARMED" ? f_side(official.side)+" PLAN ARMED" : official.state == "WIN" ? "OFFICIAL TP HIT · WIN" : official.state == "LOSS" ? "OFFICIAL SL HIT · LOSS" : official.state == "LATE" ? "OFFICIAL MISSED · SCOUT LEFT" : scout.state == "ACTIVE" ? "SCOUT EARLY "+f_side(scout.side) : scout.state == "FROZEN" ? "SCOUT "+f_side(scout.side)+" · WAIT OFFICIAL" : scout.state == "WIN" ? "SCOUT TP HIT · OFFICIAL CHECK" : scout.state == "LOSS" ? "SCOUT SL HIT · FILTER CHECK" : officialContextSide != 0 ? f_side(officialContextSide)+" BIAS" : "WAIT"
    string actionState = official.id > 0 ? official.state : scout.id > 0 ? scout.state : officialContextSide != 0 ? "BIAS" : "IDLE"
    string actionReason = official.id > 0 ? official.reason : scout.id > 0 ? scout.reason : contextInvalidated ? "CONTEXT INVALIDATED · NO AUTO-REVERSAL" : lockedDirectionSource
    string scoutLine = scout.id > 0 ? "SCOUT #"+str.tostring(scout.id)+" · "+scout.state+" · "+f_side(scout.side)+" · "+f_price(scout.entry)+" → "+f_price(scout.target) : "NO FROZEN SCOUT"
    string officialLine = official.id > 0 ? "OFFICIAL #"+str.tostring(official.id)+" · SCOUT #"+str.tostring(official.scoutId)+" · "+official.state : officialLateRecordedThisDistribution ? "OFFICIAL LATE · SCOUT ENTRY ALREADY TOUCHED" : "WAIT BRECHA / CONSENSUS PROMOTION"
    f_cell(tMaster,0,0,"♛ ELPIPO GOD · AMD LADDER MASTER v21.0",color.rgb(9,14,24),cYellow,masterBig)
    f_cell(tMaster,0,1,"SCOUT FREEZE + OFFICIAL CONFIRMATION LAB",color.rgb(9,14,24),cText,masterSmall)
    f_cell(tMaster,0,2,elpipoProfile+" · "+entryModel+" · TP "+str.tostring(tpSteps)+" / SL "+str.tostring(slSteps),cPanel,cBlue,masterSmall)
    f_cell(tMaster,0,3,"◈ AMD CONTEXT",cPanel2,cMuted,masterSmall)
    f_cell(tMaster,3,3,contextInvalidated ? "INVALID" : inDist ? "LOCKED" : "LIVE",contextInvalidated ? cInvalid : cPanel3,cText,masterSmall)
    f_cell(tMaster,0,4,f_side(officialContextSide)+" · "+lockedDirectionSource,sideDark,cText,masterBig)
    f_cell(tMaster,0,5,"ACC G "+f_pct(accumGreenPct)+" R "+f_pct(accumRedPct)+" O "+f_pct(accumOverall)+" · MAN G "+f_pct(manipGreenPct)+" R "+f_pct(manipRedPct)+" O "+f_pct(manipOverall),cPanel,sideAccent,masterSmall)
    f_cell(tMaster,0,6,"COMBO "+f_pct(signedCombo)+" · EDGE "+f_pct(officialPredictorEdge)+" · "+liveContextRead,cPanel,cSoft,masterSmall)
    f_cell(tMaster,0,7," ",color.new(cBlack,100),cText,size.tiny)
    f_cell(tMaster,0,8,"● FINAL ACTION",cPanel2,cMuted,masterSmall)
    f_cell(tMaster,3,8,actionState,f_state_bg(actionState),cText,masterSmall)
    f_cell(tMaster,0,9,actionMain,f_state_bg(actionState),cText,masterBig)
    f_cell(tMaster,0,10,actionReason,cPanel,cSoft,masterSmall)
    f_cell(tMaster,0,11,"BIAS IS NOT ENTRY · SCOUT IS RESEARCH · OFFICIAL IS EXECUTION",cPanel,cYellow,masterSmall)
    f_cell(tMaster,0,12," ",color.new(cBlack,100),cText,size.tiny)
    f_cell(tMaster,0,13," ",color.new(cBlack,100),cText,size.tiny)
    f_cell(tMaster,0,14,"⌁ FROZEN SCOUT",cPanel2,cMuted,masterSmall)
    f_cell(tMaster,3,14,scout.id > 0 ? scout.state : "NONE",scout.id > 0 ? f_state_bg(scout.state) : cIdle,cText,masterSmall)
    f_cell(tMaster,0,15,scoutLine,cPanel,scout.id > 0 ? cScout : cMuted,masterBig)
    f_cell(tMaster,0,16,scout.id > 0 ? "ENTRY "+f_price(scout.entry)+" · TP "+f_price(scout.target)+" · SL "+f_price(scout.stop) : "LIVE PROJECTION HIDDEN BY DEFAULT",cPanel,cSoft,masterSmall)
    f_cell(tMaster,0,17,scout.id > 0 ? scout.reason : "WAIT CONFIRMED SCOUT FREEZE",cPanel,cBlue,masterSmall)
    f_cell(tMaster,0,18," ",color.new(cBlack,100),cText,size.tiny)
    f_cell(tMaster,0,19," ",color.new(cBlack,100),cText,size.tiny)
    f_cell(tMaster,0,20,"✦ OFFICIAL PLAN",cPanel2,cMuted,masterSmall)
    f_cell(tMaster,3,20,official.id > 0 ? official.state : "NONE",official.id > 0 ? f_state_bg(official.state) : cIdle,cText,masterSmall)
    f_cell(tMaster,0,21,officialLine,cPanel,official.id > 0 ? cOfficial : cMuted,masterBig)
    f_cell(tMaster,0,22,official.id > 0 ? "SAME LEVELS · ENTRY "+f_price(official.entry)+" · TP "+f_price(official.target)+" · SL "+f_price(official.stop) : "OFFICIAL CANNOT RECALCULATE SCOUT LEVELS",cPanel,cSoft,masterSmall)
    f_cell(tMaster,0,23,official.id > 0 ? official.reason : "WAIT AUTHORIZATION BEFORE SCOUT ENTRY TOUCH",cPanel,cYellow,masterSmall)
    f_cell(tMaster,0,24," ",color.new(cBlack,100),cText,size.tiny)
    f_cell(tMaster,0,25," ",color.new(cBlack,100),cText,size.tiny)
    f_cell(tMaster,0,26,"⌁ BRECHA AUTHORIZATION",cPanel2,cMuted,masterSmall)
    f_cell(tMaster,3,26,f_pct(brechaAuthorityPct),brechaQualified ? cBullDark : cPanel3,cText,masterSmall)
    f_cell(tMaster,0,27,brechaStatus+" · "+str.tostring(brechaPassedCount)+"/"+str.tostring(brechaEnabledCount)+" · CATS "+str.tostring(brechaCategoriesPassed)+"/"+str.tostring(brechaCategoriesActive),cPanel,brechaQualified ? cBull : cSoft,masterSmall)
    f_cell(tMaster,0,28,brechaCategoryText+" · "+brechaMissingText,cPanel,cBlue,masterSmall)
    f_cell(tMaster,0,29," ",color.new(cBlack,100),cText,size.tiny)
    f_cell(tMaster,0,30," ",color.new(cBlack,100),cText,size.tiny)
    f_cell(tMaster,0,31," ",color.new(cBlack,100),cText,size.tiny)
    f_cell(tMaster,0,32,"✦ CONSENSUS CONFIRM / VETO",cPanel2,cMuted,masterSmall)
    f_cell(tMaster,3,32,f_pct(consensusAuthorityPct),consensusQualified ? color.rgb(118,88,20) : cPanel3,cText,masterSmall)
    f_cell(tMaster,0,33,consensusStatus+" · "+str.tostring(consensusPassedCount)+"/"+str.tostring(consensusEnabledCount)+" · CATS "+str.tostring(consensusCategoriesPassed)+"/"+str.tostring(consensusCategoriesActive),cPanel,consensusQualified ? cYellow : cSoft,masterSmall)
    f_cell(tMaster,0,34,consensusCategoryText+" · "+consensusMissingText,cPanel,cYellow,masterSmall)
    f_cell(tMaster,0,35,"AUTHORITY = RULE MATCH · NOT WIN PROBABILITY",cPanel,cWarn,masterSmall)
    f_cell(tMaster,0,36," ",color.new(cBlack,100),cText,size.tiny)
    f_cell(tMaster,0,37,"◆ MARKET",cPanel2,cMuted,masterSmall)
    f_cell(tMaster,3,37,sessionText,cPanel3,sideAccent,masterSmall)
    f_cell(tMaster,0,38,"TIME "+str.format_time(time,"hh:mm a",tz)+" · TF "+timeframe.period+" · HTF "+consensusHTF,cPanel,cSoft,masterSmall)
    f_cell(tMaster,0,39,"ENTRY IS THE DOOR · FREEZE MAKES THE TEST AUDITABLE",color.rgb(9,14,24),cYellow,masterSmall)

f_render_calendar() =>
    table.clear(tCalendar,0,0,6,11)
    int monthOffset = (calendarDesiredMonth-1)*31
    int sW = 0
    int sL = 0
    int oW = 0
    int oL = 0
    float sNet = 0.0
    float oNet = 0.0
    int missedWinners = 0
    int savedLosses = 0
    int officialLate = 0
    int ySW = 0
    int ySL = 0
    int yOW = 0
    int yOL = 0
    float ySNet = 0.0
    float yONet = 0.0
    for d = 0 to 30
        int idx = monthOffset+d
        int sr = array.get(scoutResults,idx)
        int orr = array.get(officialResults,idx)
        sW += sr == CAL_WIN ? 1 : 0
        sL += sr == CAL_LOSS ? 1 : 0
        oW += orr == CAL_WIN ? 1 : 0
        oL += orr == CAL_LOSS ? 1 : 0
        sNet += array.get(scoutPoints,idx)
        oNet += array.get(officialPoints,idx)
        missedWinners += sr == CAL_WIN and orr != CAL_WIN ? 1 : 0
        savedLosses += sr == CAL_LOSS and orr != CAL_LOSS ? 1 : 0
        officialLate += orr == CAL_LATE ? 1 : 0
    for idx = 0 to 371
        int sr = array.get(scoutResults,idx)
        int orr = array.get(officialResults,idx)
        ySW += sr == CAL_WIN ? 1 : 0
        ySL += sr == CAL_LOSS ? 1 : 0
        yOW += orr == CAL_WIN ? 1 : 0
        yOL += orr == CAL_LOSS ? 1 : 0
        ySNet += array.get(scoutPoints,idx)
        yONet += array.get(officialPoints,idx)
    string title = f_month_name(calendarDesiredMonth)+" "+str.tostring(calendarTrackedYear)+" · SCOUT vs OFFICIAL"
    string monthText = "MONTH · SCOUT "+str.tostring(sW)+"W/"+str.tostring(sL)+"L "+(sNet > 0 ? "+" : "")+str.tostring(sNet,"#")+" · OFFICIAL "+str.tostring(oW)+"W/"+str.tostring(oL)+"L "+(oNet > 0 ? "+" : "")+str.tostring(oNet,"#")
    string yearText = "YEAR · SCOUT "+str.tostring(ySW)+"W/"+str.tostring(ySL)+"L "+(ySNet > 0 ? "+" : "")+str.tostring(ySNet,"#")+" · OFFICIAL "+str.tostring(yOW)+"W/"+str.tostring(yOL)+"L "+(yONet > 0 ? "+" : "")+str.tostring(yONet,"#")
    string labText = "MISSED WINNERS "+str.tostring(missedWinners)+" · SAVED LOSSES "+str.tostring(savedLosses)+" · OFFICIAL LATE "+str.tostring(officialLate)
    f_cell(tCalendar,0,0,title,color.rgb(9,14,24),cYellow,calendarTextSize)
    f_cell(tCalendar,0,1,monthText,oNet > 0 ? cBullDark : oNet < 0 ? cBearDark : cPanel3,cText,calendarBig)
    f_cell(tCalendar,0,2,calendarShowYearSummary ? yearText : "YEAR SUMMARY OFF",cPanel3,cText,calendarBig)
    f_cell(tCalendar,0,3,labText,cPanel,cMuted,calendarSmall)
    array<string> dayNames = array.from("MON","TUE","WED","THU","FRI","SAT","SUN")
    for c = 0 to 6
        f_cell(tCalendar,c,4,array.get(dayNames,c),cPanel2,c >= 5 ? cMuted : cSoft,calendarSmall)
    for r = 5 to 10
        for c = 0 to 6
            f_cell(tCalendar,c,r," ",color.rgb(14,20,31),cMuted,calendarSmall)
    int firstTimestamp = timestamp(tz,calendarTrackedYear,calendarDesiredMonth,1,0,0)
    int firstDOW = dayofweek(firstTimestamp)
    int mondayOffset = firstDOW == dayofweek.sunday ? 6 : firstDOW-dayofweek.monday
    int daysInMonth = f_days_in_month(calendarTrackedYear,calendarDesiredMonth)
    for calendarDay = 1 to 31
        if calendarDay <= daysInMonth
            int slot = mondayOffset+calendarDay-1
            int col = slot%7
            int row = 5+int(math.floor(slot/7))
            int idx = monthOffset+calendarDay-1
            bool sd = array.get(scoutDays,idx)
            bool od = array.get(officialDays,idx)
            int sr = array.get(scoutResults,idx)
            int orr = array.get(officialResults,idx)
            int direction = sd ? array.get(scoutDirections,idx) : array.get(officialDirections,idx)
            int mins = sd ? array.get(scoutTimes,idx) : array.get(officialTimes,idx)
            string cell = str.tostring(calendarDay)
            if sd or od
                cell += "\n"+f_side_short(direction)+" · S"+f_result_symbol(sr)+" O"+f_result_symbol(orr)
                if calendarShowSignalTime and mins >= 0
                    cell += "\n"+str.tostring(int(math.floor(mins/60)),"00")+":"+str.tostring(mins%60,"00")
            int visualResult = od and orr != CAL_NONE ? orr : sr
            f_cell(tCalendar,col,row,cell,sd or od ? f_result_bg(visualResult) : color.rgb(14,20,31),sd or od ? cText : cSoft,calendarSmall)
    f_cell(tCalendar,0,11,"S = SCOUT · O = OFFICIAL · ✓ TP · × SL · L LATE · I INVALID · E EXPIRED",color.rgb(9,14,24),cMuted,calendarSmall)

if barstate.isfirst
    f_initialize_tables()
if barstate.islast
    if showMasterWindow
        f_render_master()
    else
        table.clear(tMaster,0,0,3,39)
    if showCalendar
        f_render_calendar()
    else
        table.clear(tCalendar,0,0,6,11)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 25) MARKERS + ALERTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
plotshape(showScoutMarkers and eventScoutFreeze,title="Scout Frozen",style=shape.labelup,location=location.belowbar,color=cScout,size=size.tiny,text="SCOUT",textcolor=cText)
plotshape(showScoutMarkers and eventScoutTouch,title="Scout Entry Touched",style=shape.circle,location=location.belowbar,color=cWarn,size=size.tiny,text="S",textcolor=cBlack)
plotshape(showScoutMarkers and eventScoutWin,title="Scout TP",style=shape.labeldown,location=location.abovebar,color=cBull,size=size.tiny,text="S TP",textcolor=cText)
plotshape(showScoutMarkers and eventScoutLoss,title="Scout SL",style=shape.labeldown,location=location.abovebar,color=cBear,size=size.tiny,text="S SL",textcolor=cText)
plotshape(eventOfficialArm,title="Official Plan Armed",style=shape.labelup,location=location.belowbar,color=cOfficial,size=size.tiny,text="ARM",textcolor=cBlack)
plotshape(eventOfficialTouch,title="Official Entry Touched",style=shape.circle,location=location.belowbar,color=cWarn,size=size.tiny,text="T",textcolor=cBlack)
plotshape(eventOfficialActive,title="Official Entry Accepted",style=shape.labelup,location=location.belowbar,color=cActive,size=size.tiny,text="ACTIVE",textcolor=cText)
plotshape(eventOfficialWin,title="Official TP",style=shape.labeldown,location=location.abovebar,color=cBull,size=size.tiny,text="O TP",textcolor=cText)
plotshape(eventOfficialLoss,title="Official SL",style=shape.labeldown,location=location.abovebar,color=cBear,size=size.tiny,text="O SL",textcolor=cText)
plotshape(eventOfficialLate,title="Official Late",style=shape.labeldown,location=location.abovebar,color=cIdle,size=size.tiny,text="LATE",textcolor=cText)
alertcondition(eventScoutFreeze,"ELPIPO v21 SCOUT FROZEN","A confirmed Scout froze Entry, TP and SL. Dashed levels will not move.")
alertcondition(eventScoutTouch,"ELPIPO v21 SCOUT ENTRY TOUCHED","The frozen Scout Entry was touched before or alongside official confirmation.")
alertcondition(eventScoutWin,"ELPIPO v21 SCOUT TP HIT","The frozen Scout research plan hit TP.")
alertcondition(eventScoutLoss,"ELPIPO v21 SCOUT SL HIT","The frozen Scout research plan hit SL.")
alertcondition(eventOfficialArm,"ELPIPO v21 OFFICIAL PLAN ARMED","The same frozen Scout levels were promoted to an Official Plan.")
alertcondition(eventOfficialTouch,"ELPIPO v21 OFFICIAL ENTRY TOUCHED","Official Entry touched. Wait for acceptance when required.")
alertcondition(eventOfficialActive,"ELPIPO v21 OFFICIAL ENTRY ACCEPTED","Official Entry received acceptance and is active.")
alertcondition(eventOfficialWin,"ELPIPO v21 OFFICIAL TP HIT","The Official Plan hit TP.")
alertcondition(eventOfficialLoss,"ELPIPO v21 OFFICIAL SL HIT","The Official Plan hit SL.")
alertcondition(eventOfficialLate,"ELPIPO v21 OFFICIAL MISSED SCOUT","Scout Entry touched before Official authorization. The day is recorded as Official Late.")
alertcondition(contextInvalidated,"ELPIPO v21 CONTEXT INVALIDATED","The locked AMD context was invalidated. No automatic reversal was created.")
alertcondition(distStart,"ELPIPO v21 DISTRIBUTION STARTED","Distribution started. AMD context is locked and Scout evaluation is active.")
