//@version=6
indicator("ELPIPO GOD AMD LADDER MASTER v21.0 — SCOUT FREEZE + OFFICIAL CONFIRMATION LAB", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=5000, dynamic_requests=false)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ELPIPO v21 CORE RULES
// 1) Accumulation + Manipulation create the directional context.
// 2) Distribution validates timing and entry permission.
// 3) LIVE PROJECTION may move and is hidden by default.
// 4) SCOUT freezes Entry, TP and SL on a confirmed candle.
// 5) OFFICIAL can only promote the exact frozen Scout levels.
// 6) Scout and Official outcomes are measured separately.
// 7) Invalidation cancels the idea. It never auto-reverses.
// 8) Authority is rule match, not guaranteed win probability.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 0) VISUAL COCKPIT
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
gUI = "0. Visual Cockpit"
showMasterWindow = input.bool(true, "Show GOD Master Window", group=gUI)
masterWindowPosInput = input.string("Top Left", "Master Window Position", options=["Top Left","Top Center","Top Right","Middle Left","Middle Center","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group=gUI)
masterWindowSizeInput = input.string("Medium", "Master Window Text Size", options=["Tiny","Small","Medium","Large"], group=gUI)
chartTextSizeInput = input.string("Small", "Chart Text Size", options=["Tiny","Small","Medium","Large"], group=gUI)
showSessionBoxes = input.bool(true, "Show AMD Session Boxes", group=gUI)
showSessionNames = input.bool(true, "Show AMD Session Names", group=gUI)
showQuadrants = input.bool(true, "Show Accumulation / Manipulation Quadrants", group=gUI)
showCenterLines = input.bool(true, "Show Session Center Lines", group=gUI)
showYellowCandles = input.bool(true, "Show Dominant Yellow Candles", group=gUI)
showLadder = input.bool(true, "Show Distribution Ladder +3 To -3", group=gUI)
showLadderPreview = input.bool(true, "Show Ladder Preview During Manipulation", group=gUI)
showLevelLabels = input.bool(true, "Show Ladder Level Labels", group=gUI)
showTradeMap = input.bool(true, "Show Entry / TP / SL Map", group=gUI)
showTradeMapLabels = input.bool(true, "Show Entry / TP / SL Price Tags", group=gUI)
showLiveProjection = input.bool(false, "Show Moving LIVE PROJECTION (Research Only)", group=gUI)
showScoutPlan = input.bool(true, "Show Frozen SCOUT Plan", group=gUI)
showPipDimensions = input.bool(true, "Show Architectural Pip Dimensions", group=gUI)
showPatternMarkers = input.bool(false, "Show S+ Pattern Markers", group=gUI)
gridRightBars = input.int(12, "Grid Right Context Bars", minval=4, maxval=40, group=gUI)
previewBars = input.int(40, "Preview Length Bars", minval=5, maxval=200, group=gUI)
inactiveLineWidth = input.int(1, "Inactive Grid Width", minval=1, maxval=3, group=gUI)
activeLineWidth = input.int(3, "Active Plan Width", minval=2, maxval=5, group=gUI)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 1) AMD SESSIONS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
gSess = "1. AMD Sessions"
tz = input.string("America/New_York", "Timezone", group=gSess)
accumSession = input.session("1900-0100", "Accumulation Session", group=gSess)
manipSession = input.session("0100-0700", "Manipulation Session", group=gSess)
manipSecondHalfSession = input.session("0400-0700", "Manipulation Second Half", group=gSess)
distSession = input.session("0700-1300", "Distribution Session", group=gSess)
onlyTradeDistribution = input.bool(true, "Hard Gate: Plans Only In Distribution", group=gSess)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 2) PROFILE + FINITE EXECUTION CHOICES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
gProfile = "2. Profile + Finite Execution Choices"
