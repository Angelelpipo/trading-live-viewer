bA31 = profileCustom ? b31 : not profileProfit
bA32 = profileCustom ? b32 : false
bA33 = profileCustom ? b33 : false
bA34 = profileCustom ? b34 : false
bA35 = profileCustom ? b35 : false
bA36 = profileCustom ? b36 : profilePrecision
bA37 = profileCustom ? b37 : false
bA38 = profileCustom ? b38 : false
bA39 = profileCustom ? b39 : false
bA40 = profileCustom ? b40 : false
bA41 = profileCustom ? b41 : true
bA42 = profileCustom ? b42 : profilePrecision
bA43 = profileCustom ? b43 : true
bA44 = profileCustom ? b44 : profilePrecision
bA45 = profileCustom ? b45 : false
bA46 = profileCustom ? b46 : profilePrecision
bA47 = profileCustom ? b47 : false
bA48 = profileCustom ? b48 : not profileProfit
bA49 = profileCustom ? b49 : false
bA50 = profileCustom ? b50 : profilePrecision
array<bool> bEnabled = array.from(bA01,bA02,bA03,bA04,bA05,bA06,bA07,bA08,bA09,bA10,bA11,bA12,bA13,bA14,bA15,bA16,bA17,bA18,bA19,bA20,bA21,bA22,bA23,bA24,bA25,bA26,bA27,bA28,bA29,bA30,bA31,bA32,bA33,bA34,bA35,bA36,bA37,bA38,bA39,bA40,bA41,bA42,bA43,bA44,bA45,bA46,bA47,bA48,bA49,bA50)
array<bool> bPassed = array.from(sweepSeen,reclaimEvent,levelEventOK,breakHold,wickRejectionOK,armedDirectionOK,armedBodyOK,armedCloseOK,wickBalanceOK,expansionQualityOK,structureOK,higherLowLowerHighOK,microBOSNow,oppositeStructureFailureOK,pullbackStructureIntegrityOK,evalEntryInsideGap,premiumDiscountOK,notOverextendedOK,outsideCongestionOK,imbalanceAlignedOK,weakOppositeBodyOK,controlledRetracementOK,lowOverlapOK,noOppositeEngulfingOK,healthyPullbackDurationOK,structuralSLOK,stopBeyondWickClusterOK,stopOutsideATROK,stopOutsideArmedBodyOK,stopProtectedByLevelOK,clearPathToTPOK,noLiquidityWallOK,tpBeforeSessionBoundaryOK,tpOutsideCongestionOK,tpNextLiquidityOK,bodyATRQualityOK,stepATRQualityOK,noAbnormalSpikeOK,compressionBeforeExpansionOK,stableDistributionRangeOK,earlyProgressOK,setupFreshnessOK,notPaidOK,notLateOK,onePlanAvailableOK,noOppositeShiftOK,noOppositePatternOK,directionRemainsValidOK,triggerLevelValidOK,planIntactBeforeEntryOK)

f_authority(array<bool> enabled,array<bool> passed,string engineName) =>
    int enabledCount = 0
    int passedCount = 0
    int categoriesActive = 0
    int categoriesPassed = 0
    float categoryAuthorityTotal = 0.0
    string categoryText = ""
    string firstMissing = "ALL ACTIVE RECRUITS PASSED"
    for categoryIndex = 0 to 9
        int categoryEnabled = 0
        int categoryPassed = 0
        for slot = 0 to 4
            int recruitIndex = categoryIndex*5+slot
            bool en = array.get(enabled,recruitIndex)
            bool pa = array.get(passed,recruitIndex)
            if en
                enabledCount += 1
                categoryEnabled += 1
                if pa
                    passedCount += 1
                    categoryPassed += 1
                else if firstMissing == "ALL ACTIVE RECRUITS PASSED"
                    firstMissing := (engineName == "BRECHA" ? "MISSING B" : "MISSING C") + str.tostring(recruitIndex+1,"00")
        if categoryEnabled > 0
            categoriesActive += 1
            float categoryRatio = categoryPassed*1.0/categoryEnabled
            bool categoryOK = categoryRatio >= 0.60
            categoriesPassed += categoryOK ? 1 : 0
            categoryAuthorityTotal += categoryRatio*100.0
            string code = engineName == "BRECHA" ? (categoryIndex == 0 ? "TRG" : categoryIndex == 1 ? "CAN" : categoryIndex == 2 ? "STR" : categoryIndex == 3 ? "ENT" : categoryIndex == 4 ? "PB" : categoryIndex == 5 ? "SL" : categoryIndex == 6 ? "TP" : categoryIndex == 7 ? "VOL" : categoryIndex == 8 ? "TIM" : "INV") : (categoryIndex == 0 ? "DIR" : categoryIndex == 1 ? "XEN" : categoryIndex == 2 ? "HTF" : categoryIndex == 3 ? "REG" : categoryIndex == 4 ? "TIM" : categoryIndex == 5 ? "RSK" : categoryIndex == 6 ? "PRB" : categoryIndex == 7 ? "CNF" : categoryIndex == 8 ? "MAN" : "SRV")
            categoryText += (categoryText == "" ? "" : " · ") + code + (categoryOK ? "✓" : "×")
    float authority = categoriesActive > 0 ? categoryAuthorityTotal/categoriesActive : 0.0
    [enabledCount,passedCount,authority,categoriesActive,categoriesPassed,categoryText,firstMissing]

[brechaEnabledCount,brechaPassedCount,brechaAuthorityPct,brechaCategoriesActive,brechaCategoriesPassed,brechaCategoryText,brechaMissingText] = f_authority(bEnabled,bPassed,"BRECHA")
brechaFoundationPass = (not bA03 or array.get(bPassed,2)) and (not bA06 or array.get(bPassed,5)) and (not bA11 or array.get(bPassed,10)) and (not bA16 or array.get(bPassed,15)) and (not bA26 or array.get(bPassed,25))
brechaVetoPass = (not bA38 or array.get(bPassed,37)) and (not bA43 or array.get(bPassed,42)) and (not bA44 or array.get(bPassed,43)) and (not bA46 or array.get(bPassed,45)) and (not bA48 or array.get(bPassed,47)) and (not bA50 or array.get(bPassed,49))
brechaQualified = inDist and scout.id > 0 and scout.state == "FROZEN" and brechaEnabledCount > 0 and brechaFoundationPass and brechaVetoPass and brechaAuthorityPct >= presetAuthorityMinBrecha and brechaCategoriesPassed >= math.min(presetCategoryQuorumBrecha,brechaCategoriesActive)
brechaStatus = not useBrechaGate ? "GATE OFF" : brechaQualified ? "AUTHORIZED" : scout.id == 0 ? "WAIT SCOUT FREEZE" : contextInvalidated ? "CONTEXT INVALIDATED" : not brechaFoundationPass ? "FOUNDATION BLOCK" : not brechaVetoPass ? "ACTIVE VETO" : triggerBuilding ? "BUILDING " + f_side(evalSide) : "WAIT LOCAL EVIDENCE"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 19) CONSENSUS AUTHORITY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
consensusDirectionMatch = evalSide != 0 and evalSide == lockedDirection
consensusPredictorEdgeOK = officialPredictorEdge >= presetPredictorEdge
consensusComboEdgeOK = evalSide == 1 ? signedCombo >= presetComboEdge : evalSide == -1 ? signedCombo <= -presetComboEdge : false
consensusAMDYellowAgreementOK = accYQualified and manipYQualified and accYDir == evalSide and manipYDir == evalSide
consensusPsychBiasOK = evalSide == 1 ? officialBullScore > officialBearScore : evalSide == -1 ? officialBearScore > officialBullScore : false
consensusBrechaLadderOK = brechaQualified and evalEntryInsideGap
consensusBrechaPsychOK = brechaQualified and consensusPsychBiasOK
consensusPatternOK = beforeArmPatternOK
consensusTrendOK = trendAgreementOK
consensusFinalActionOK = brechaQualified and evalRiskMapValid and not evalTimingLate and not evalTimingPaid
consensusHTFDirectionOK = not useHTFContext or (evalSide == 1 ? htfEMA20 > htfEMA50 : evalSide == -1 ? htfEMA20 < htfEMA50 : false)
consensusHTFStructureOK = not useHTFContext or (evalSide == 1 ? htfClose > htfEMA20 and htfRSI >= 50.0 : evalSide == -1 ? htfClose < htfEMA20 and htfRSI <= 50.0 : false)
consensusHTFLiquidityOK = not useHTFContext or (evalSide == 1 ? htfClose < htfHigh20 : evalSide == -1 ? htfClose > htfLow20 : false)
consensusHTFStrengthOK = not useHTFContext or (not na(htfATR) and htfATR > 0 and math.abs(htfEMA20-htfEMA50)/htfATR >= 0.25)
consensusLTFTriggerOK = levelEventOK and armedDirectionOK
consensusTrendRegimeOK = localADX >= presetADXMin and (evalSide == 1 ? localDIPlus > localDIMinus : evalSide == -1 ? localDIMinus > localDIPlus : false)
consensusNoChopOK = localADX >= presetADXMin
consensusVolatilityRegimeOK = atr > 0 and atr/ta.sma(atr,20) >= 0.65 and atr/ta.sma(atr,20) <= 1.80
consensusExpansionRegimeOK = expansionQualityOK
consensusNoMeanReversionConflictOK = evalSide == 1 ? close <= localEMA20+atr*2.0 : evalSide == -1 ? close >= localEMA20-atr*2.0 : false
consensusSessionPhaseOK = inDist and not evalTimingLate and not evalTimingPaid and evalMovementProgress <= presetMaxProgress
consensusLeadOK = evalMovementProgress <= 60.0 and not evalTimingLate
consensusFreshnessOK = setupFreshnessOK
consensusExpirationOK = scout.id > 0 and (na(scout.expiryBar) or bar_index <= scout.expiryBar)
consensusSLEfficiencyOK = slSteps*1.0/math.max(tpSteps,1) <= 2.5
consensusTPObstacleOK = clearPathToTPOK and (noLiquidityWallOK or tpNextLiquidityOK)
consensusSameBarRiskOK = not na(evalStep) and rng < evalStep*math.max(tpSteps,slSteps)
consensusGapThroughRiskOK = not na(evalEntry) and not na(evalStep) and math.abs(close-evalEntry) <= evalStep*1.25
consensusStrongPredictorOK = consensusPredictorEdgeOK and officialPredictorEdge >= presetPredictorEdge*1.50
consensusStrongComboOK = consensusComboEdgeOK and comboAbs >= presetComboEdge*1.50
consensusSessionProbabilityOK = evalMovementProgress >= 10.0 and evalMovementProgress <= 55.0
consensusRegimeProbabilityOK = consensusTrendRegimeOK and consensusHTFDirectionOK
consensusEntryDepthOK = entryModel == "Mid-Body 50%" ? evalEntryInsideGap : premiumDiscountOK
consensusNoDirectionConflictOK = consensusDirectionMatch and not dualYellowConflict
consensusNoContextConflictOK = not bothAccumSweeps and not contextInvalidated
consensusNoPatternConflictOK = noOppositePatternOK
consensusNoVolatilityConflictOK = noAbnormalSpikeOK and stepATRQualityOK
consensusNoTimingConflictOK = not evalTimingLate and not evalTimingPaid
consensusDualYellowStrengthOK = consensusAMDYellowAgreementOK
consensusFalseBalanceOK = balanceContext and manipYQualified and manipYDir == evalSide
consensusSilentEdgeOK = silentAccum and silentManip and manipYDir == evalSide
consensusTrapProbabilityOK = not bothAccumSweeps and largestManipWickDir == evalSide
consensusAsymmetryOK = math.abs(nz(accumOverall,0.0)-nz(manipOverall,0.0)) >= 8.0 and (evalSide == 1 ? signedCombo > 0 : evalSide == -1 ? signedCombo < 0 : false)
consensusPlanStillQualifiedOK = brechaQualified and evalRiskMapValid
consensusNoOppAuthoritySurgeOK = evalSide == 1 ? signedCombo >= -presetComboEdge and officialBullScore >= officialBearScore : evalSide == -1 ? signedCombo <= presetComboEdge and officialBearScore >= officialBullScore : false
consensusEntryDistanceOK = not na(evalEntry) and not na(evalStep) and math.abs(close-evalEntry) <= evalStep*1.50
consensusNotStaleOK = not evalTimingLate and not evalTimingPaid and evalMovementProgress <= presetMaxProgress
