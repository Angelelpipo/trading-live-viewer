entryModel = input.string("Mid-Body 50%", "Entry Model", options=["Mid-Body 50%","Ladder Boundary","Reclaim Boundary"], group=gProfile)
tpStepChoice = input.string("2 Steps", "Take Profit Distance", options=["1 Step","2 Steps","3 Steps"], group=gProfile)
slStepChoice = input.string("4 Steps", "Stop Loss Distance", options=["1 Step","2 Steps","3 Steps","4 Steps"], group=gProfile)
sameBarPolicy = input.string("Ambiguous", "TP + SL Same-Bar Policy", options=["Ambiguous","Conservative Loss"], group=gProfile)
requireNextBarEntry = input.bool(true, "Entry Activates Only After Freeze / Arm Candle", group=gProfile)
requireAcceptance = input.bool(true, "Official: Touch Activates Idea; Acceptance Activates Trade", group=gProfile)
requireCorrectCenterSide = input.bool(true, "Require Correct Side Of Distribution Center", group=gProfile)
onePlanPerDistribution = input.bool(true, "One Official Plan Per Distribution", group=gProfile)
blockLatePlans = input.bool(true, "Block New Official Plans When Late", group=gProfile)
blockPaidPlans = input.bool(true, "Block New Official Plans When Paid", group=gProfile)
cancelOnContextInvalidation = input.bool(true, "Cancel Pending Official Plan On Context Invalidation", group=gProfile)
useBrechaGate = input.bool(true, "Brecha Must Authorize Official Plan", group=gProfile)
useConsensusVeto = input.bool(true, "Consensus May Confirm / Veto Official Plan", group=gProfile)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
